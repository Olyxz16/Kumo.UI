<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:kumo="using:KumoThemeSupport.Controls"
        xmlns:ksup="using:KumoThemeSupport"
        xmlns:kd="using:Kumo.Demo"
        mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="900"
        x:Class="Kumo.Demo.MainWindow"
        Title="Kumo for Avalonia"
        Width="880" Height="900"
        Background="{DynamicResource KumoBrushCanvas}"
        Foreground="{DynamicResource KumoBrushTextDefault}"
        FontSize="{StaticResource KumoFontSizeBase}">

    <Panel>
        <ScrollViewer>
        <StackPanel Margin="40,32" MaxWidth="800" Spacing="24">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Kumo for Avalonia"
                               FontSize="{StaticResource KumoFontSizeXxl}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource KumoBrushTextStrong}" />
                    <TextBlock Text="Cloudflare design system tokens, on Avalonia"
                               Foreground="{DynamicResource KumoBrushTextSubtle}" />
                </StackPanel>
                <ToggleButton x:Name="ThemeToggle" Grid.Column="1"
                              Content="Dark mode"
                              VerticalAlignment="Center"
                              Click="OnToggleTheme" />
            </Grid>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Surfaces" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                            </Grid>
                    <UniformGrid Columns="6" Rows="1">
                        <StackPanel Spacing="4">
                            <Border Height="56" CornerRadius="8" Background="{DynamicResource KumoBrushCanvas}" BorderBrush="{DynamicResource KumoBrushHairline}" BorderThickness="1" />
                            <TextBlock Text="canvas" FontSize="{StaticResource KumoFontSizeSm}" Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <Border Height="56" CornerRadius="8" Background="{DynamicResource KumoBrushBase}" BorderBrush="{DynamicResource KumoBrushHairline}" BorderThickness="1" />
                            <TextBlock Text="base" FontSize="{StaticResource KumoFontSizeSm}" Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <Border Height="56" CornerRadius="8" Background="{DynamicResource KumoBrushElevated}" BorderBrush="{DynamicResource KumoBrushHairline}" BorderThickness="1" />
                            <TextBlock Text="elevated" FontSize="{StaticResource KumoFontSizeSm}" Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <Border Height="56" CornerRadius="8" Background="{DynamicResource KumoBrushRecessed}" BorderBrush="{DynamicResource KumoBrushHairline}" BorderThickness="1" />
                            <TextBlock Text="recessed" FontSize="{StaticResource KumoFontSizeSm}" Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <Border Height="56" CornerRadius="8" Background="{DynamicResource KumoBrushTint}" BorderBrush="{DynamicResource KumoBrushHairline}" BorderThickness="1" />
                            <TextBlock Text="tint" FontSize="{StaticResource KumoFontSizeSm}" Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <Border Height="56" CornerRadius="8" Background="{DynamicResource KumoBrushContrast}" />
                            <TextBlock Text="contrast" FontSize="{StaticResource KumoFontSizeSm}" Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Palette" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                            </Grid>
                    <TextBlock Text="54 semantic tokens, one chip per KumoBrush resource. Chips re-resolve when you toggle dark mode."
                               FontSize="{StaticResource KumoFontSizeSm}"
                               Foreground="{DynamicResource KumoBrushTextSubtle}" />
                    <WrapPanel x:Name="SemanticSwatches" />
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Status" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                            </Grid>
                    <UniformGrid Columns="4" Rows="1">
                        <Border Margin="0,0,8,0" Padding="12,8" CornerRadius="8" Background="{DynamicResource KumoBrushInfoTint}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource KumoBrushInfo}" VerticalAlignment="Center" />
                                <TextBlock Text="Info" Foreground="{DynamicResource KumoBrushTextInfo}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,8,0" Padding="12,8" CornerRadius="8" Background="{DynamicResource KumoBrushSuccessTint}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource KumoBrushSuccess}" VerticalAlignment="Center" />
                                <TextBlock Text="Success" Foreground="{DynamicResource KumoBrushTextSuccess}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,8,0" Padding="12,8" CornerRadius="8" Background="{DynamicResource KumoBrushWarningTint}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource KumoBrushWarning}" VerticalAlignment="Center" />
                                <TextBlock Text="Warning" Foreground="{DynamicResource KumoBrushTextWarning}" />
                            </StackPanel>
                        </Border>
                        <Border Padding="12,8" CornerRadius="8" Background="{DynamicResource KumoBrushDangerTint}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource KumoBrushDanger}" VerticalAlignment="Center" />
                                <TextBlock Text="Danger" Foreground="{DynamicResource KumoBrushTextDanger}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Buttons" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                            </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary" Content="Primary" ToolTip.Tip="Primary action" />
                        <Button Content="Secondary" />
                        <Button Classes="danger" Content="Delete" />
                        <Button Classes="ghost" Content="Ghost" />
                        <Button Content="Disabled" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                      Data="M7,1 L7,13 M1,7 L13,7"
                                      Stroke="{DynamicResource KumoBrushTextDefault}" StrokeThickness="1.5" />
                                <TextBlock Text="Create Worker" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="primary">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                      Data="M7,1 L7,13 M1,7 L13,7"
                                      Stroke="{DynamicResource KumoBrushWhite}" StrokeThickness="1.5" />
                                <TextBlock Text="Create Worker" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Inputs" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="polish" /></Border>
                            </Grid>
                    <TextBox PlaceholderText="Worker name"
                             MinWidth="{StaticResource KumoInputMinWidth}"
                             MaxWidth="{StaticResource KumoInputMaxWidth}"
                             HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CheckBox Content="Enable observability" IsChecked="True" />
                        </StackPanel>
                        <CheckBox Content="Indeterminate" IsChecked="{x:Null}" IsThreeState="True" />
                        <CheckBox Content="Disabled" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <RadioButton GroupName="demo" Content="Workers" IsChecked="True" />
                        <RadioButton GroupName="demo" Content="Zones" />
                        <RadioButton GroupName="demo2" Content="Disabled" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <ToggleSwitch Content="Preview" IsChecked="True" />
                        <ToggleSwitch Content="Draft" />
                        <ToggleSwitch Content="Off" IsEnabled="False" />
                    </StackPanel>
                    <ComboBox MaxWidth="320" HorizontalAlignment="Left" PlaceholderText="Environment"
                              SelectedIndex="1">
                        <ComboBoxItem>Production</ComboBoxItem>
                        <ComboBoxItem>Staging</ComboBoxItem>
                        <ComboBoxItem>Development</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Tabs" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                            </Grid>
                    <TabControl>
                        <TabItem Header="Overview">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Overview content" />
                                <Border Classes="skeleton-line" Width="280" HorizontalAlignment="Left" />
                                <Border Classes="skeleton-line" Width="220" HorizontalAlignment="Left" />
                                <Border Classes="skeleton-line" Width="250" HorizontalAlignment="Left" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Metrics">
                            <TextBlock Text="Metrics content" />
                        </TabItem>
                        <TabItem Header="Logs">
                            <TextBlock Text="Logs content" />
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="KumoTabs" FontWeight="SemiBold"
                                   Foreground="{DynamicResource KumoBrushTextStrong}" />
                        <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                    </Grid>
                    <TextBlock Text="TabControl subclass with the sliding indicator pill (translate + scaleX morph) enabled out of the box." FontSize="{StaticResource KumoFontSizeXs}"
                               Foreground="{DynamicResource KumoBrushTextSubtle}" />
                    <kumo:KumoTabs MaxWidth="420" HorizontalAlignment="Left">
                        <TabItem Header="Settings">
                            <TextBlock Text="Settings content" />
                        </TabItem>
                        <TabItem Header="Deployments">
                            <TextBlock Text="Deployments content" />
                        </TabItem>
                    </kumo:KumoTabs>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="KumoToolbar" FontWeight="SemiBold"
                                   Foreground="{DynamicResource KumoBrushTextStrong}" />
                        <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                    </Grid>
                    <TextBlock Text="Toolbar surface (ring + shadow); content sits between the leading and trailing edges." FontSize="{StaticResource KumoFontSizeXs}"
                               Foreground="{DynamicResource KumoBrushTextSubtle}" />
                    <kumo:KumoToolbar MaxWidth="480" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="icon" Click="OnToolbarFilterMenu">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Data="M4,6 L20,6 M4,12 L16,12 M4,18 L14,18"
                                      Stroke="{DynamicResource KumoBrushTextDefault}" StrokeThickness="1.5" />
                            </Button>
                            <Border Classes="divider" />
                            <TextBox Name="MemberFilter" Width="150" PlaceholderText="Filter members"
                                     BorderThickness="0" Background="Transparent" MinHeight="30"
                                     TextChanged="OnMemberFilterChanged" />
                            <Border Classes="divider" />
                            <Button Classes="icon" Click="OnAddMember">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Data="M12,5 L12,19 M5,12 L19,12"
                                      Stroke="{DynamicResource KumoBrushTextDefault}" StrokeThickness="1.5" />
                            </Button>
                        </StackPanel>
                        <kumo:KumoToolbar.Trailing>
                            <Button Classes="primary sm" Content="Invite" Margin="6,0,4,0" Click="OnInviteMember" />
                        </kumo:KumoToolbar.Trailing>
                    </kumo:KumoToolbar>
                    <ItemsControl Name="MemberList" HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="KumoAvatar" FontWeight="SemiBold"
                                   Foreground="{DynamicResource KumoBrushTextStrong}" />
                        <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                    </Grid>
                    <TextBlock Text="Deterministic fallback hue + initials from DisplayName; sizes xs-lg." FontSize="{StaticResource KumoFontSizeXs}"
                               Foreground="{DynamicResource KumoBrushTextSubtle}" />
                    <StackPanel Orientation="Horizontal" Spacing="32" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <kumo:KumoAvatar DisplayName="Ada Lovelace" />
                            <kumo:KumoAvatar DisplayName="Grace Hopper" />
                            <kumo:KumoAvatar DisplayName="Alan" />
                            <kumo:KumoAvatar DisplayName="Zhang Wei" Size="lg" />
                        </StackPanel>
                        <kumo:KumoAvatarGroup
                            Names="Ada Lovelace, Grace Hopper, Alan Zhang, Zhang Wei, Alan Kay, Margaret Hamilton"
                            Max="4" />
                        <kumo:KumoAvatarGroup Direction="back"
                            Names="Ada Lovelace, Grace Hopper, Alan Zhang, Zhang Wei, Alan Kay, Margaret Hamilton"
                            Max="4" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="KumoBadge" FontWeight="SemiBold"
                                   Foreground="{DynamicResource KumoBrushTextStrong}" />
                        <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                    </Grid>
                    <TextBlock Text="One Variant property maps to the pill + palette (primary, info, error, beta, blue)." FontSize="{StaticResource KumoFontSizeXs}"
                               Foreground="{DynamicResource KumoBrushTextSubtle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <kumo:KumoBadge Text="Primary" Variant="primary" VerticalAlignment="Center" />
                        <kumo:KumoBadge Text="Info" Variant="info" VerticalAlignment="Center" />
                        <kumo:KumoBadge Text="Error" Variant="error" VerticalAlignment="Center" />
                        <kumo:KumoBadge Text="Beta" Variant="beta" VerticalAlignment="Center" />
                        <kumo:KumoBadge Text="Blue" Variant="blue" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="KumoEmptyState" FontWeight="SemiBold"
                                   Foreground="{DynamicResource KumoBrushTextStrong}" />
                        <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                    </Grid>
                    <TextBlock Text="Typed Icon / Title / Description / CommandContent slots with upstream paddings built in." FontSize="{StaticResource KumoFontSizeXs}"
                               Foreground="{DynamicResource KumoBrushTextSubtle}" />
                    <kumo:KumoEmptyState
                        Title="No workers yet"
                        Description="Create your first worker to deploy code across the Cloudflare network."
                        MaxWidth="460" HorizontalAlignment="Left">
                        <kumo:KumoEmptyState.Icon>
                            <Path Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center"
                                  Data="M7,10 L17,10 M7,14 L13,14 M5,4 L19,4 A3,3 0 0 1 22,7 L22,17 A3,3 0 0 1 19,20 L5,20 A3,3 0 0 1 2,17 L2,7 A3,3 0 0 1 5,4 Z"
                                  Stroke="{DynamicResource KumoBrushTextInactive}" StrokeThickness="1.5" />
                        </kumo:KumoEmptyState.Icon>
                        <kumo:KumoEmptyState.CommandContent>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="primary" Content="Create worker" />
                            </StackPanel>
                        </kumo:KumoEmptyState.CommandContent>
                    </kumo:KumoEmptyState>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Badges" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                            </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="badge primary"><TextBlock Text="Primary" /></Border>
                        <Border Classes="badge secondary"><TextBlock Text="Secondary" /></Border>
                        <Border Classes="badge info"><TextBlock Text="Info" /></Border>
                        <Border Classes="badge success"><TextBlock Text="Success" /></Border>
                        <Border Classes="badge warning"><TextBlock Text="Warning" /></Border>
                        <Border Classes="badge error"><TextBlock Text="Error" /></Border>
                        <Border Classes="badge outline"><TextBlock Text="Outline" /></Border>
                        <Border Classes="badge beta"><TextBlock Text="Beta" /></Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="badge red"><TextBlock Text="Red" /></Border>
                        <Border Classes="badge green"><TextBlock Text="Green" /></Border>
                        <Border Classes="badge neutral"><TextBlock Text="Neutral" /></Border>
                        <Border Classes="badge orange"><TextBlock Text="Orange" /></Border>
                        <Border Classes="badge purple"><TextBlock Text="Purple" /></Border>
                        <Border Classes="badge teal"><TextBlock Text="Teal" /></Border>
                        <Border Classes="badge blue"><TextBlock Text="Blue" /></Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Banners and progress" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                            </Grid>
                    <Border Classes="banner info">
                        <TextBlock Text="Scheduled maintenance on Sunday, 02:00 UTC." TextWrapping="Wrap" />
                    </Border>
                    <Border Classes="banner warning">
                        <TextBlock Text="Your certificate expires in 7 days." TextWrapping="Wrap" />
                    </Border>
                    <Border Classes="banner secondary">
                        <TextBlock Text="Secondary tone banner — neutral text on a subtle surface." TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,4,0,0">
                        <ProgressBar Value="65" MinWidth="220" />
                        <ProgressBar Classes="success" Value="100" MinWidth="220" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,4,0,0">
                        <ProgressBar Classes="meter warning" Minimum="0" Maximum="80" Value="64" MinWidth="220" MinHeight="8" />
                        <ProgressBar Classes="meter info" Value="30" MinWidth="220" MinHeight="8" />
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" MinWidth="220" HorizontalAlignment="Left" />
                    <TextBlock Text="Flush integration: the meter caps a surface and only rounds the away-edge."
                               FontSize="{StaticResource KumoFontSizeSm}"
                               Foreground="{DynamicResource KumoBrushTextSubtle}" />
                    <StackPanel Spacing="0" HorizontalAlignment="Stretch">
                        <ProgressBar Classes="docked-top meter info" Value="70" />
                        <Border Background="{DynamicResource KumoBrushBase}"
                                BorderBrush="{DynamicResource KumoBrushHairline}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource KumoRadiusDockedBottom}"
                                ClipToBounds="True">
                            <StackPanel Spacing="6" Margin="16,12">
                                <TextBlock Text="api.cloudflare.com — propagation sweep" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <TextBlock Text="Rolling 20 regional deployments" Foreground="{DynamicResource KumoBrushTextSubtle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Menus" FontWeight="SemiBold"
                                   Foreground="{DynamicResource KumoBrushTextStrong}" />
                        <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Actions">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Deploy" />
                                    <MenuItem Header="Restart" />
                                    <MenuItem Header="Pause" IsEnabled="False" />
                                    <Separator />
                                    <MenuItem Header="Delete" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Content="Right-click me">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy" />
                                    <MenuItem Header="Paste" />
                                    <Separator />
                                    <MenuItem Header="Settings" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Content="Popover">
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel MaxWidth="240" Spacing="8">
                                        <TextBlock Text="Popover title" FontWeight="SemiBold" Foreground="{DynamicResource KumoBrushTextStrong}" />
                                        <TextBlock Text="Some supporting detail shown in the flyout surface." TextWrapping="Wrap" Foreground="{DynamicResource KumoBrushTextSubtle}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Collapsible" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                            </Grid>
                    <Expander Header="How do I rotate an API token?" IsExpanded="True">
                        <TextBlock Text="Tokens can be rotated from the dashboard under My Profile, or with the API."
                                   TextWrapping="Wrap" FontWeight="Normal"
                                   Foreground="{DynamicResource KumoBrushTextDefault}" />
                    </Expander>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Toasts" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                            </Grid>
                    <TextBlock Text="Live notifications at the bottom-right corner. Auto-dismiss after 4 seconds."
                               FontSize="{StaticResource KumoFontSizeSm}"
                               Foreground="{DynamicResource KumoBrushTextSubtle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary" Content="Success toast" Click="OnShowToast" Tag="success" />
                        <Button Content="Info toast" Click="OnShowToast" Tag="info" />
                        <Button Content="Warning toast" Click="OnShowToast" Tag="warning" />
                        <Button Classes="danger" Content="Error toast" Click="OnShowToast" Tag="error" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="layer-card" Background="{DynamicResource KumoBrushElevated}">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Text scale" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                            </Grid>
                    <TextBlock Text="3xl heading, 30px" FontSize="{StaticResource KumoFontSize3xl}" Foreground="{DynamicResource KumoBrushTextStrong}" />
                    <TextBlock Text="xxl heading, 24px" FontSize="{StaticResource KumoFontSizeXxl}" FontWeight="SemiBold" Foreground="{DynamicResource KumoBrushTextStrong}" />
                    <TextBlock Text="lg subheading, 16px" FontSize="{StaticResource KumoFontSizeLg}" Foreground="{DynamicResource KumoBrushTextDefault}" />
                    <TextBlock Text="base content text, 14px" FontSize="{StaticResource KumoFontSizeBase}" Foreground="{DynamicResource KumoBrushTextDefault}" />
                    <TextBlock Text="sm caption, 13px" FontSize="{StaticResource KumoFontSizeSm}" Foreground="{DynamicResource KumoBrushTextSubtle}" />
                    <TextBlock Text="xs label, 12px" FontSize="{StaticResource KumoFontSizeXs}" Foreground="{DynamicResource KumoBrushTextSubtle}" />
                </StackPanel>
            </Border>


            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Links &amp; code" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                            </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <HyperlinkButton Content="Read the docs" NavigateUri="https://kumo-ui.com" />
                        <HyperlinkButton Classes="plain" Content="Plain link" NavigateUri="https://kumo-ui.com" />
                        <TextBlock Classes="link" Text="Current-color link" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource KumoBrushTextDefault}">
                        <Run Text="Deploy with " />
                        <InlineUIContainer>
                            <Border Classes="code-inline">
                                <TextBlock Text="npx wrangler deploy" />
                            </Border>
                        </InlineUIContainer>
                        <Run Text=" in " />
                        <InlineUIContainer>
                            <Border Classes="code-inline">
                                <TextBlock Text="wrangler.toml" />
                            </Border>
                        </InlineUIContainer>
                        <Run Text=" The variable " />
                        <InlineUIContainer>
                            <Border Classes="code-inline">
                                <TextBlock Text="WRANGLER_ENV" />
                            </Border>
                        </InlineUIContainer>
                        <Run Text=" must equal " />
                        <InlineUIContainer>
                            <Border Classes="code-inline">
                                <TextBlock Text="production" />
                            </Border>
                        </InlineUIContainer>
                        <Run Text=" or the build is skipped." />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource KumoBrushTextDefault}">
                        <Run Text="The path " />
                        <InlineUIContainer>
                            <Border Classes="code-inline">
                                <TextBlock Text="src/workers/sources/producer.ts" />
                            </Border>
                        </InlineUIContainer>
                        <Run Text=" exports " />
                        <InlineUIContainer>
                            <Border Classes="code-inline">
                                <TextBlock Text="onInboundRequest()" />
                            </Border>
                        </InlineUIContainer>
                        <Run Text=", dispatched as " />
                        <InlineUIContainer>
                            <Border Classes="code-inline">
                                <TextBlock Text="fetch" />
                            </Border>
                        </InlineUIContainer>
                        <Run Text=" in the docs, follows response codes " />
                        <InlineUIContainer>
                            <Border Classes="code-inline">
                                <TextBlock Text="204" />
                            </Border>
                        </InlineUIContainer>
                        <Run Text=" and " />
                        <InlineUIContainer>
                            <Border Classes="code-inline">
                                <TextBlock Text="503" />
                            </Border>
                        </InlineUIContainer>
                        <Run Text="." />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="secondary" Text="Section path" VerticalAlignment="Center" />
                            <Border Classes="code-inline lg">
                                <TextBlock Text="webpack.config.dev.js" />
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="code" Text="v2.13.1" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource KumoBrushTextDefault}">
                        <Run Text="Secondary mono for data: " />
                        <Run Text="worker-a7f3c2" FontFamily="{StaticResource KumoFontMono}"
                             Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        <Run Text="; strong mono outside code: " />
                        <Run Text="export NODE_ENV=production" FontFamily="{StaticResource KumoFontMono}" />
                    </TextBlock>
                    <Border Classes="code-block" MaxWidth="460" HorizontalAlignment="Left">
                        <SelectableTextBlock Text="# deploy to production&#10;$ npx wrangler deploy --env production&#10;Uploading 12 files...&#10;+ Deployed to https://kumo-demo.workers.dev" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Loaders &amp; meters" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                            </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                        <Panel Classes="loader loader-sm" />
                        <Panel Classes="loader" />
                        <Panel Classes="loader loader-lg" />
                        <Panel Classes="loader loader-sm" TextElement.Foreground="{DynamicResource KumoBrushSuccess}" />
                        <Panel Classes="loader loader-sm" TextElement.Foreground="{DynamicResource KumoBrushDanger}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Bandwidth used" FontSize="{StaticResource KumoFontSizeXs}"
                                       Foreground="{DynamicResource KumoBrushTextSubtle}" />
                            <TextBlock Grid.Column="1" Text="1.2 TB / 2 TB" FontSize="{StaticResource KumoFontSizeSm}"
                                       FontWeight="Medium" Foreground="{DynamicResource KumoBrushTextDefault}" />
                        </Grid>
                        <ProgressBar Classes="meter" Value="62" Maximum="100" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="CPU" FontSize="{StaticResource KumoFontSizeXs}"
                                       Foreground="{DynamicResource KumoBrushTextSubtle}" />
                            <TextBlock Grid.Column="1" Text="94%" FontSize="{StaticResource KumoFontSizeSm}"
                                       FontWeight="Medium" Foreground="{DynamicResource KumoBrushTextDefault}" />
                        </Grid>
                        <ProgressBar Classes="meter danger" Value="94" Maximum="100" />
                    </StackPanel>
                    <ProgressBar Classes="meter warning" Value="80" Maximum="100" />
                    <ProgressBar Classes="meter info" Value="45" Maximum="100" />
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Toolbar &amp; menubar" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <Border Classes="badge neutral" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="planned" /></Border>
                            </Grid>
                    <Border Classes="toolbar" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="icon">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Data="M12,5 L12,19 M5,12 L19,12"
                                      Stroke="{DynamicResource KumoBrushTextDefault}" StrokeThickness="1.5" />
                            </Button>
                            <Button Classes="icon">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Data="M6,16 L6,11 A6,6 0 1 1 18,11 L18,16 M4,16 L20,16 M10,19 A2,2 0 0 0 14,19"
                                      Stroke="{DynamicResource KumoBrushTextDefault}" StrokeThickness="1.5" />
                            </Button>
                            <TextBox Width="150" PlaceholderText="Filter resources" VerticalAlignment="Center" />
                            <Button Classes="icon">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Data="M5,12 L10,17 L19,7"
                                      Stroke="{DynamicResource KumoBrushTextDefault}" StrokeThickness="1.5" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Classes="menubar" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="icon active">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Data="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18"
                                      Stroke="{DynamicResource KumoBrushTextDefault}" StrokeThickness="1.5" />
                            </Button>
                            <Button Classes="icon">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Data="M12,5 L12,19 M5,12 L19,12"
                                      Stroke="{DynamicResource KumoBrushTextDefault}" StrokeThickness="1.5" />
                            </Button>
                            <Button Classes="icon">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      Data="M9.5,7 L14.5,12 L9.5,17"
                                      Stroke="{DynamicResource KumoBrushTextDefault}" StrokeThickness="1.5" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <Menu HorizontalAlignment="Left">
                        <MenuItem Header="Edit">
                            <MenuItem Header="Undo" />
                            <MenuItem Header="Redo" />
                            <Separator />
                            <MenuItem Header="Select all" />
                        </MenuItem>
                        <MenuItem Header="View">
                            <MenuItem Header="Toggle dark mode" />
                            <MenuItem Header="Zoom in" />
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Field, input group &amp; special inputs" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                            </Grid>
                    <StackPanel Spacing="6" MaxWidth="420" HorizontalAlignment="Left">
                        <TextBlock Foreground="{DynamicResource KumoBrushTextDefault}">
                            <Run Text="API token" FontWeight="Medium" />
                            <Run Text=" (optional)" FontSize="{StaticResource KumoFontSizeXs}"
                                 Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        </TextBlock>
                        <TextBox PlaceholderText="sk_live_..." />
                        <TextBlock Classes="field-description" Text="Used to authenticate requests against the API." />
                        <TextBlock Classes="field-error" Text="Token expired. Rotate it in My Profile." />
                    </StackPanel>
                    <Border Classes="input-group" MaxWidth="300" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="210" PlaceholderText="Search docs" BorderThickness="0"
                                     Background="Transparent" />
                            <Button Classes="icon">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Data="M11,3 A8,8 0 1 0 11.01,3 Z M16,16 L20,20"
                                      Stroke="{DynamicResource KumoBrushTextDefault}" StrokeThickness="1.5" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <TextBox Classes="multiline" AcceptsReturn="True" PlaceholderText="Deployment notes..."
                             MaxWidth="360" HorizontalAlignment="Left" />
                    <StackPanel Spacing="6" MaxWidth="420" HorizontalAlignment="Left">
                        <TextBlock Classes="field-label" Text="Environment" />
                        <AutoCompleteBox Name="EnvAutocomplete" PlaceholderText="production"
                                         FilterMode="Contains" MaxDropDownHeight="220" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Name="SensitiveInput" Classes="password" Text="hunter2-secret-value" Width="240" />
                        <Button Classes="icon ghost" Click="OnToggleReveal">
                            <Path x:Name="EyeGlyph" Width="20" Height="11" Stretch="Uniform" Margin="0,3,0,0"
                                  Data="M2,12 C5,6.5 19,6.5 22,12 C19,17.5 5,17.5 2,12 M12,9 A3,3 0 1 0 12.01,9"
                                  Stroke="{DynamicResource KumoBrushTextDefault}" StrokeThickness="1.5" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Breadcrumbs &amp; pagination" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                            </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="breadcrumb" Content="Dashboard" />
                        <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                              Data="M9.5,7 L14.5,12 L9.5,17"
                              Stroke="{DynamicResource KumoBrushTextInactive}" StrokeThickness="1.5" />
                        <Button Classes="breadcrumb" Content="Projects" />
                        <Path Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                              Data="M9.5,7 L14.5,12 L9.5,17"
                              Stroke="{DynamicResource KumoBrushTextInactive}" StrokeThickness="1.5" />
                        <TextBlock Classes="breadcrumb-current" Text="Kumo Avalonia" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                        <TextBlock Classes="pagination-info" Text="Showing 1 &#8211; 10 of 128" VerticalAlignment="Center" />
                        <Border Classes="pagination-separator" />
                        <Border Classes="input-group page-nav" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PageFirst" Classes="icon" Tag="first" Click="OnPageNav" ToolTip.Tip="First page">
                                    <Path Width="14" Height="14" Stretch="Uniform"
                                          Data="M19,6 L13,12 L19,18 M11,6 L5,12 L11,18"
                                          Stroke="{DynamicResource KumoBrushTextDefault}" StrokeThickness="1.4" />
                                </Button>
                                <Button x:Name="PagePrev" Classes="icon" Tag="prev" Click="OnPageNav" ToolTip.Tip="Previous page">
                                    <Path Width="7" Height="14" Stretch="Uniform"
                                          Data="M15,18 L9,12 L15,6"
                                          Stroke="{DynamicResource KumoBrushTextDefault}" StrokeThickness="1.25" />
                                </Button>
                                <TextBox Name="PageInput" Width="52" Text="1" TextAlignment="Center"
                                         MinHeight="30" VerticalAlignment="Center"
                                         KeyDown="OnPageInputKeyDown" LostFocus="OnPageInputLostFocus" />
                                <Button x:Name="PageNext" Classes="icon" Tag="next" Click="OnPageNav" ToolTip.Tip="Next page">
                                    <Path Width="7" Height="14" Stretch="Uniform"
                                          Data="M9,18 L15,12 L9,6"
                                          Stroke="{DynamicResource KumoBrushTextDefault}" StrokeThickness="1.25" />
                                </Button>
                                <Button x:Name="PageLast" Classes="icon" Tag="last" Click="OnPageNav" ToolTip.Tip="Last page">
                                    <Path Width="14" Height="14" Stretch="Uniform"
                                          Data="M5,6 L11,12 L5,18 M13,6 L19,12 L13,18"
                                          Stroke="{DynamicResource KumoBrushTextDefault}" StrokeThickness="1.4" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Table" FontWeight="SemiBold"
                                   Foreground="{DynamicResource KumoBrushTextStrong}" />
                        <Border Classes="badge neutral" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                    </Grid>
                    <kumo:KumoTable MaxWidth="560" HorizontalAlignment="Left">
                        <kumo:KumoTable.Columns>
                            <kumo:KumoTableColumn Header="Region" />
                            <kumo:KumoTableColumn Header="Status" Width="120" />
                            <kumo:KumoTableColumn Header="Requests" Width="110" AlignRight="True" Mono="True" />
                        </kumo:KumoTable.Columns>
                        <kumo:KumoTable.Rows>
                            <kumo:KumoTableRow Cells="North America,Healthy,24.1M" />
                            <kumo:KumoTableRow Cells="Europe,Degraded,12.9M" />
                            <kumo:KumoTableRow Cells="Asia Pacific,Healthy,8.4M" IsSelected="True" />
                        </kumo:KumoTable.Rows>
                    </kumo:KumoTable>
                    <TextBlock Text="Same component without the selection column — column alignment is unchanged because header and body share one grid:"
                               FontSize="{StaticResource KumoFontSizeXs}"
                               Foreground="{DynamicResource KumoBrushTextSubtle}"
                               MaxWidth="560" />
                    <kumo:KumoTable MaxWidth="560" HorizontalAlignment="Left" ShowSelectionColumn="False">
                        <kumo:KumoTable.Columns>
                            <kumo:KumoTableColumn Header="Region" />
                            <kumo:KumoTableColumn Header="Status" Width="120" />
                            <kumo:KumoTableColumn Header="Requests" Width="110" AlignRight="True" Mono="True" />
                        </kumo:KumoTable.Columns>
                        <kumo:KumoTable.Rows>
                            <kumo:KumoTableRow Cells="North America,Healthy,24.1M" />
                            <kumo:KumoTableRow Cells="Europe,Degraded,12.9M" />
                            <kumo:KumoTableRow Cells="Asia Pacific,Healthy,8.4M" />
                        </kumo:KumoTable.Rows>
                    </kumo:KumoTable>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Empty state" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                            </Grid>
                    <Border Classes="empty empty-sm" MaxWidth="520" HorizontalAlignment="Left">
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <Path Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center"
                                  Data="M3,6 A3,3 0 0 1 6,3 L18,3 A3,3 0 0 1 21,6 L21,18 A3,3 0 0 1 18,21 L6,21 A3,3 0 0 1 3,18 Z M3,9 L21,9 M8,13 L16,13"
                                  Stroke="{DynamicResource KumoBrushTextInactive}" StrokeThickness="1.5" />
                            <StackPanel Spacing="4">
                                <TextBlock Classes="empty-title" Text="No zones yet" />
                                <TextBlock Classes="empty-description"
                                           Text="Add your first zone to start proxying traffic through the edge." />
                            </StackPanel>
                            <Button Classes="primary" Content="Add zone" HorizontalAlignment="Center" />
                            <Border Classes="empty-command">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="empty-command-prefix" Text="$" />
                                    <TextBlock Classes="empty-command-text" Text="npx wrangler zones add example.com" />
                                    <Button Classes="icon ghost icon-sm">
                                        <Path Width="14" Height="14" Stretch="Uniform"
                                              Data="M9,9 L19,9 L19,19 L9,19 Z M15,9 L15,5 L5,5 L5,15 L9,15"
                                              Stroke="{DynamicResource KumoBrushTextInactive}" StrokeThickness="1.5" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Dialog" FontWeight="SemiBold"
                                           Foreground="{DynamicResource KumoBrushTextStrong}" />
                                <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                            </Grid>
                    <TextBlock Text="In-app modal overlay: subtle scrim + centered dialog surface with ring shadow and dialog typography."
							   FontSize="{StaticResource KumoFontSizeSm}"
                               Foreground="{DynamicResource KumoBrushTextSubtle}" />
                    <Button Content="Open dialog" Click="OnOpenDialog" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Classes="layer-card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Windowed controls" FontWeight="SemiBold"
                                   Foreground="{DynamicResource KumoBrushTextStrong}" />
                        <Border Classes="badge success" Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="done" /></Border>
                    </Grid>
                    <TextBlock Text="Avalonia controls themed to finish the surface: path icon, transitioning presenter, group box, drop-down button, spinner and masked input."
                               FontSize="{StaticResource KumoFontSizeSm}"
                               Foreground="{DynamicResource KumoBrushTextSubtle}" />
                    <StackPanel Spacing="10">
                        <TextBlock Text="Panes" FontSize="{StaticResource KumoFontSizeSm}"
                                   Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        <StackPanel Spacing="12">
                            <Border Classes="layer-card" Height="180" Width="600" HorizontalAlignment="Left">
                                <SplitView DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="140"
                                          PaneBackground="{DynamicResource KumoBrushRecessed}">
                                    <SplitView.Pane>
                                        <StackPanel Spacing="4" Margin="8">
                                            <TextBlock Text="Side pane" FontSize="{StaticResource KumoFontSizeSm}" />
                                        </StackPanel>
                                    </SplitView.Pane>
                                    <Grid ColumnDefinitions="*, Auto, *">
                                        <TextBlock Text="Content" FontSize="{StaticResource KumoFontSizeSm}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <GridSplitter Grid.Column="1" Width="8" />
                                        <Border Grid.Column="2" Background="{DynamicResource KumoBrushRecessed}" />
                                    </Grid>
                                </SplitView>
                            </Border>
                            <Border Classes="layer-card" Height="180" Width="600" HorizontalAlignment="Left">
                                <!-- Fixed: no splitter, pane keeps its width; a
                                     Slider below drives OpenPaneLength so the
                                     mid value splits the card evenly -->
                                <SplitView x:Name="DemoFixedSplit" DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="140"
                                          PaneBackground="{DynamicResource KumoBrushRecessed}">
                                    <SplitView.Pane>
                                        <StackPanel Spacing="4" Margin="8">
                                            <TextBlock Text="Fixed pane" FontSize="{StaticResource KumoFontSizeSm}" />
                                        </StackPanel>
                                    </SplitView.Pane>
                                    <TextBlock Text="Content" FontSize="{StaticResource KumoFontSizeSm}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </SplitView>
                            </Border>
                            <StackPanel Spacing="6" Width="600" HorizontalAlignment="Left">
                                <Slider x:Name="DemoFixedSplitSize"
                                        Minimum="0" Maximum="560"
                                        Value="{Binding OpenPaneLength, ElementName=DemoFixedSplit, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch" />
                                <TextBlock Text="Drag to resize the fixed pane (mid = even split)"
                                           FontSize="{StaticResource KumoFontSizeSm}"
                                           Foreground="{DynamicResource KumoBrushTextSubtle}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="Trees" FontSize="{StaticResource KumoFontSizeSm}"
                                   Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        <Border Background="{DynamicResource KumoBrushTint}"
                                CornerRadius="{StaticResource KumoRadiusMd}" MaxWidth="320" HorizontalAlignment="Left">
                            <TreeView x:Name="DemoTree" Margin="4"
                                      SelectionMode="Single">
                                <TreeViewItem Header="Projects" IsExpanded="True">
                                    <TreeViewItem Header="kumo-avalonia" IsSelected="True">
                                        <TreeViewItem Header="Palette.axaml" />
                                        <TreeViewItem Header="Controls/" IsExpanded="True">
                                            <TreeViewItem Header="Button.axaml" />
                                            <TreeViewItem Header="TreeView.axaml" />
                                        </TreeViewItem>
                                    </TreeViewItem>
                                    <TreeViewItem Header="kumo-react" IsEnabled="False" />
                                </TreeViewItem>
                                <TreeViewItem Header="Archive">
                                    <TreeViewItem Header="2025 releases" />
                                </TreeViewItem>
                            </TreeView>
                        </Border>
                        <TextBlock Text="Pips and refresh" FontSize="{StaticResource KumoFontSizeSm}"
                                   Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <StackPanel Spacing="6">
                                <PipsPager x:Name="DemoPips" NumberOfPages="7" SelectedPageIndex="3" HorizontalAlignment="Left" />
                                <TextBlock Text="PipsPager (dot = page)"
                                           FontSize="{StaticResource KumoFontSizeSm}"
                                           Foreground="{DynamicResource KumoBrushTextSubtle}" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <Carousel x:Name="DemoCarousel" Width="220" Height="96" SelectionChanged="OnDemoCarouselSlide">
                                    <Border Background="{DynamicResource KumoBrushInfoTint}" CornerRadius="{StaticResource KumoRadiusMd}" Margin="4">
                                        <TextBlock Text="Slide 1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Background="{DynamicResource KumoBrushSuccessTint}" CornerRadius="{StaticResource KumoRadiusMd}" Margin="4">
                                        <TextBlock Text="Slide 2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Background="{DynamicResource KumoBrushDangerTint}" CornerRadius="{StaticResource KumoRadiusMd}" Margin="4">
                                        <TextBlock Text="Slide 3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Carousel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="ghost" Click="OnDemoSlidePrev" Content="Prev" />
                                    <Button Classes="ghost" Click="OnDemoSlideNext" Content="Next" />
                                </StackPanel>
                                <TextBlock x:Name="DemoCarouselState" Text="Carousel (buttons/arrow keys to slide)"
                                           FontSize="{StaticResource KumoFontSizeSm}"
                                           Foreground="{DynamicResource KumoBrushTextSubtle}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="6" Width="320" HorizontalAlignment="Left">
                            <!-- RefreshContainer adapts an inner ScrollViewer: the
                                 pull gesture lives there, so the card hosts its own
                                 small scroller; IsMouseEnabled allows desktop drag -->
                            <RefreshContainer x:Name="DemoRefresh" IsMouseEnabled="True" Background="{DynamicResource KumoBrushTint}"
                                              CornerRadius="{StaticResource KumoRadiusMd}"
                                              Height="136" RefreshRequested="OnDemoRefreshRequested">
                                <ScrollViewer Height="136" VerticalAlignment="Top">
                                    <StackPanel Spacing="6" Margin="12">
                                        <TextBlock Text="Drag down to refresh" FontSize="{StaticResource KumoFontSizeSm}" FontWeight="Medium" />
                                        <TextBlock Text="Inbox · 3 unread" FontSize="{StaticResource KumoFontSizeSm}"
                                                   Foreground="{DynamicResource KumoBrushTextSubtle}" />
                                        <TextBlock Text="updated" x:Name="DemoRefreshStamp"
                                                   FontSize="{StaticResource KumoFontSizeSm}"
                                                   Foreground="{DynamicResource KumoBrushTextSubtle}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </RefreshContainer>
                            <TextBlock Text="Refresh card (drag content down)"
                                       FontSize="{StaticResource KumoFontSizeSm}"
                                       Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        </StackPanel>
                        <TextBlock Text="Table" FontSize="{StaticResource KumoFontSizeSm}"
                                   Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        <TableView x:Name="DemoTable" Height="168" HorizontalAlignment="Left" Width="520">
                            <TableView.Columns>
                                <TableViewColumn Header="Region" Width="*" Binding="{Binding Region}" />
                                <TableViewColumn Header="Instances" Width="120" Binding="{Binding Instances}" />
                                <TableViewColumn Header="Status" Width="110" Binding="{Binding Status}" />
                            </TableView.Columns>
                            <TableView.ItemsSource>
                                <kd:DemoServerRows />
                            </TableView.ItemsSource>
                        </TableView>
                        <TextBlock Text="Date and time" FontSize="{StaticResource KumoFontSizeSm}"
                                   Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                            <DatePicker Width="220" Margin="0,0,16,8" />
                            <TimePicker Width="180" Margin="0,0,16,8" />
                            <TimePicker Width="140" ClockIdentifier="24HourClock" Margin="0,0,16,8" />
                            <CalendarDatePicker Width="200" PlaceholderText="Pick a date" Margin="0,0,16,8" />
                        </WrapPanel>
                        <TextBlock Text="Split buttons" FontSize="{StaticResource KumoFontSizeSm}"
                                   Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <SplitButton Width="200" Content="Allocate quota">
                                <SplitButton.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="Same as this team" />
                                        <MenuItem Header="Same as last quarter" />
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>
                            <ToggleSplitButton x:Name="DemoPreflightToggle" Width="220" Content="Expand preflight"
                                               ksup:SplitChevronToggle.IsEnabled="True"
                                               IsCheckedChanged="OnDemoPreflightChecked" />
                        </StackPanel>
                        <TextBlock x:Name="DemoPreflightState" Text="Toggle: switch pinned state on click (no flyout)"
                                   FontSize="{StaticResource KumoFontSizeSm}"
                                   Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        <TextBlock Text="Command strip" FontSize="{StaticResource KumoFontSizeSm}"
                                   Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        <CommandBar Background="{DynamicResource KumoBrushBase}"
                                    HorizontalAlignment="Left" MaxWidth="420">
                            <CommandBar.PrimaryCommands>
                                <CommandBarButton Label="Copy">
                                    <CommandBarButton.Icon>
                                        <Path Width="14" Height="14" Stretch="Uniform"
                                              Data="M8,8 L14,8 L14,14 L8,14 Z M4,4 L10,4"
                                              Stroke="{DynamicResource KumoBrushTextDefault}" StrokeThickness="1.4" />
                                    </CommandBarButton.Icon>
                                </CommandBarButton>
                                <CommandBarSeparator IsVisible="True" />
                                <CommandBarToggleButton Label="Pin">
                                    <CommandBarToggleButton.Icon>
                                        <Path Width="14" Height="14" Stretch="Uniform"
                                              Data="M9,9 L19,9 L19,19 L9,19 Z M15,9 L15,5 L5,5 L5,15 L9,15"
                                              Stroke="{DynamicResource KumoBrushTextDefault}" StrokeThickness="1.4" />
                                    </CommandBarToggleButton.Icon>
                                </CommandBarToggleButton>
                                <CommandBarButton Label="Paste" />
                            </CommandBar.PrimaryCommands>
                        </CommandBar>
                        <TextBlock Text="Slider" FontSize="{StaticResource KumoFontSizeSm}"
                                   Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <Slider Width="220" Minimum="0" Maximum="100" Value="35" />
                            <Slider Width="220" Minimum="0" Maximum="100" Value="50" Ticks="0,25,50,75,100"
                                   IsSnapToTickEnabled="True" TickPlacement="BottomRight" />
                        </StackPanel>
                        <TextBlock Text="Spinner inputs" FontSize="{StaticResource KumoFontSizeSm}"
                                   Foreground="{DynamicResource KumoBrushTextSubtle}" />
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <NumericUpDown Width="200" Minimum="0" Maximum="1000" Value="42" Increment="1" />
                            <NumericUpDown Width="200" Minimum="0" Maximum="1000" Value="8" Increment="1"
                                           ButtonSpinnerLocation="Left" HorizontalContentAlignment="Right" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Width="16" Height="16" Foreground="{DynamicResource KumoBrushTextSubtle}"
                                      Data="M12 2 L15 9 L22 9 L17 14 L19 21 L12 17 L5 21 L7 14 L2 9 L9 9 Z" />
                            <PathIcon Width="16" Height="16" Foreground="{DynamicResource KumoBrushBlue700}"
                                      Data="M4 4 L20 4 L20 20 L4 20 Z M4 4 L20 20 M20 4 L4 20" />
                            <TextBlock Text="PathIcon — icon surface: fill from Foreground, geometry from Data" FontSize="{StaticResource KumoFontSizeSm}" VerticalAlignment="Center" />
                        </StackPanel>
                        <DropDownButton Content="Services" HorizontalAlignment="Left">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Compute" />
                                    <MenuItem Header="Storage" />
                                    <MenuItem Header="Networking" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <ButtonSpinner Name="DemoSpinner" ShowButtonSpinner="True" Width="220"
                                       HorizontalAlignment="Left" Spin="OnDemoSpin">
                            <Border Classes="field-label">
                                <TextBlock Name="DemoSpinnerText" Text="42 instances" />
                            </Border>
                        </ButtonSpinner>
                        <MaskedTextBox Mask="000000" Width="220" HorizontalAlignment="Left" PlaceholderText="040529" />
                        <Grid ColumnDefinitions="*" Width="220" HorizontalAlignment="Left">
                            <TransitioningContentControl Name="DemoTransitioner">
                                <TransitioningContentControl.PageTransition>
                                    <CrossFade Duration="0:0:0.4" />
                                </TransitioningContentControl.PageTransition>
                                <TextBlock Text="TransitioningContentControl: swap content to see the 400ms fade" TextWrapping="Wrap" />
                            </TransitioningContentControl>
                        </Grid>
                        <Button Classes="ghost icon icon-sm" Click="OnNextTransitionDemo">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Data="M8,4 L16,12 L8,20"
                                  Stroke="{DynamicResource KumoBrushTextDefault}" StrokeThickness="1.5" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

                    </StackPanel>
        </ScrollViewer>

        <!-- In-app modal (Dialog surface/scrim presets) hosted inside the
             window: no separate OS window -> no window-manager frame shadow. -->
        <Panel x:Name="ModalOverlay" Background="{DynamicResource KumoBrushDialogScrim}" IsVisible="False">
            <Border Classes="dialog-surface" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="dialog-title" Text="Delete zone?" />
                        <Button Classes="icon ghost icon-sm" Grid.Column="1" Click="OnCloseModal">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Data="M6,6 L18,18 M18,6 L6,18"
                                  Stroke="{DynamicResource KumoBrushTextSubtle}" StrokeThickness="1.5" />
                        </Button>
                    </Grid>
                    <TextBlock Classes="dialog-description"
                               Text="This permanently removes example.com and all of its DNS records. This action cannot be undone." />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="OnCloseModal" />
                        <Button Classes="danger" Content="Delete zone" Click="OnCloseModal" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>
    </Panel>
</Window>
