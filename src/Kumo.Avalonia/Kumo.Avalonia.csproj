<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Title>Kumo.Avalonia</Title>
    <Description>Kumo (Cloudflare's design system) as an Avalonia theme: semantic color tokens with light/dark variants and starter control styles.</Description>
    <!-- The XAML compiler must see the embedded !AvaloniaResources index when
         other projects compile against this library; stripped ref assemblies
         break that (AVLN2000 "!AvaloniaResources" on cold builds). -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
  </ItemGroup>

</Project>
