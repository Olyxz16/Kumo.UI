<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Slider: recessed 4px track, brand fill + brand thumb with base ring.
         Horizontal + vertical templates; tick bars surface when TickPlacement
         is set. -->

    <Styles.Resources>
    <ResourceDictionary>

    <!-- Filled segment (decrease side): brand fill -->
    <ControlTheme x:Key="KumoSliderDecreaseRepeatButtonHorizontal" TargetType="RepeatButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Height="16" VerticalAlignment="Center" Background="Transparent" />
                    <Border Height="4" VerticalAlignment="Center"
                            CornerRadius="{StaticResource KumoRadiusFull}"
                            Background="{TemplateBinding Background}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="KumoSliderDecreaseRepeatButtonVertical" TargetType="RepeatButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Width="16" HorizontalAlignment="Center" Background="Transparent" />
                    <Border Width="4" HorizontalAlignment="Center"
                            CornerRadius="{StaticResource KumoRadiusFull}"
                            Background="{TemplateBinding Background}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- Unfilled segment (increase side): recessed track -->
    <ControlTheme x:Key="KumoSliderIncreaseRepeatButtonHorizontal" TargetType="RepeatButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Height="16" VerticalAlignment="Center" Background="Transparent" />
                    <Border Height="4" VerticalAlignment="Center"
                            CornerRadius="{StaticResource KumoRadiusFull}"
                            Background="{TemplateBinding Background}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="KumoSliderIncreaseRepeatButtonVertical" TargetType="RepeatButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border Width="16" HorizontalAlignment="Center" Background="Transparent" />
                    <Border Width="4" HorizontalAlignment="Center"
                            CornerRadius="{StaticResource KumoRadiusFull}"
                            Background="{TemplateBinding Background}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="KumoSliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <ControlTemplate>
                <!-- flat pill: a shadow repaints on every 1px move and can
                     half-draw under fast drags on X11 (perceived flicker) -->
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{StaticResource KumoRadiusFull}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushBrand}" />
        <Setter Property="Background" Value="{DynamicResource KumoBrushRecessed}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusFull}" />
        <Style Selector="^:horizontal">
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Grid Margin="{TemplateBinding Padding}"
                              MinHeight="24" VerticalAlignment="Center">
                          <Grid.Styles>
                            <Style Selector="TickBar">
                              <Setter Property="ReservedSpace" Value="{Binding #PART_Track.Thumb.Bounds}" />
                            </Style>
                          </Grid.Styles>
                          <Grid ColumnDefinitions="Auto,Auto,*">
                            <TickBar Name="TopTickBar"
                                     Grid.ColumnSpan="3"
                                     Ticks="{TemplateBinding Ticks}"
                                     TickFrequency="{TemplateBinding Slider.TickFrequency}"
                                     Orientation="{TemplateBinding Slider.Orientation}"
                                     Minimum="{TemplateBinding Slider.Minimum}"
                                     Maximum="{TemplateBinding Slider.Maximum}"
                                     Height="6"
                                     Margin="0,0,0,4"
                                     VerticalAlignment="Bottom"
                                     Placement="Top"
                                     IsVisible="False"
                                     IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                     Fill="{DynamicResource KumoBrushTextInactive}" />
                            <TickBar Name="BottomTickBar"
                                     Grid.ColumnSpan="3"
                                     Ticks="{TemplateBinding Ticks}"
                                     TickFrequency="{TemplateBinding Slider.TickFrequency}"
                                     Orientation="{TemplateBinding Slider.Orientation}"
                                     Minimum="{TemplateBinding Slider.Minimum}"
                                     Maximum="{TemplateBinding Slider.Maximum}"
                                     Height="6"
                                     Margin="0,4,0,0"
                                     VerticalAlignment="Top"
                                     Placement="Bottom"
                                     IsVisible="False"
                                     IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                     Fill="{DynamicResource KumoBrushTextInactive}" />
                            <Track Name="PART_Track"
                                   Grid.ColumnSpan="3"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                   Orientation="Horizontal">
                              <Track.DecreaseButton>
                                <RepeatButton Name="PART_DecreaseButton"
                                              Theme="{StaticResource KumoSliderDecreaseRepeatButtonHorizontal}"
                                              Background="{TemplateBinding Foreground}"
                                              Focusable="False" />
                              </Track.DecreaseButton>
                              <Track.IncreaseButton>
                                <RepeatButton Name="PART_IncreaseButton"
                                              Theme="{StaticResource KumoSliderIncreaseRepeatButtonHorizontal}"
                                              Background="{TemplateBinding Background}"
                                              Focusable="False" />
                              </Track.IncreaseButton>
                              <Thumb Name="SliderThumb"
                                     Width="16" Height="16"
                                     Background="{DynamicResource KumoBrushBrand}"
                                     Theme="{StaticResource KumoSliderThumb}" />
                            </Track>
                          </Grid>
                        </Grid>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="^:vertical">
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Grid Margin="{TemplateBinding Padding}"
                              MinWidth="24" HorizontalAlignment="Center">
                          <Grid.Styles>
                            <Style Selector="TickBar">
                              <Setter Property="ReservedSpace" Value="{Binding #PART_Track.Thumb.Bounds}" />
                            </Style>
                          </Grid.Styles>
                          <Grid RowDefinitions="*,Auto,Auto"
                                ColumnDefinitions="Auto,*,Auto">
                            <TickBar Name="LeftTickBar"
                                     Grid.RowSpan="3"
                                     Ticks="{TemplateBinding Ticks}"
                                     TickFrequency="{TemplateBinding Slider.TickFrequency}"
                                     Orientation="{TemplateBinding Slider.Orientation}"
                                     Minimum="{TemplateBinding Slider.Minimum}"
                                     Maximum="{TemplateBinding Slider.Maximum}"
                                     Width="6"
                                     Margin="0,0,4,0"
                                     HorizontalAlignment="Right"
                                     Placement="Left"
                                     IsVisible="False"
                                     IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                     Fill="{DynamicResource KumoBrushTextInactive}" />
                            <TickBar Name="RightTickBar"
                                     Grid.RowSpan="3"
                                     Grid.Column="2"
                                     Ticks="{TemplateBinding Ticks}"
                                     TickFrequency="{TemplateBinding Slider.TickFrequency}"
                                     Orientation="{TemplateBinding Slider.Orientation}"
                                     Minimum="{TemplateBinding Slider.Minimum}"
                                     Maximum="{TemplateBinding Slider.Maximum}"
                                     Width="6"
                                     Margin="4,0,0,0"
                                     HorizontalAlignment="Left"
                                     Placement="Right"
                                     IsVisible="False"
                                     IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                     Fill="{DynamicResource KumoBrushTextInactive}" />
                            <Track Name="PART_Track"
                                   Grid.RowSpan="3"
                                   Grid.Column="1"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value, Mode=TwoWay}"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                   Orientation="Vertical">
                              <Track.DecreaseButton>
                                <RepeatButton Name="PART_DecreaseButton"
                                              Theme="{StaticResource KumoSliderDecreaseRepeatButtonVertical}"
                                              Background="{TemplateBinding Foreground}"
                                              Focusable="False" />
                              </Track.DecreaseButton>
                              <Track.IncreaseButton>
                                <RepeatButton Name="PART_IncreaseButton"
                                              Theme="{StaticResource KumoSliderIncreaseRepeatButtonVertical}"
                                              Background="{TemplateBinding Background}"
                                              Focusable="False" />
                              </Track.IncreaseButton>
                              <Thumb Name="SliderThumb"
                                     Width="16" Height="16"
                                     Background="{DynamicResource KumoBrushBrand}"
                                     Theme="{StaticResource KumoSliderThumb}" />
                            </Track>
                          </Grid>
                        </Grid>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#TopTickBar, ^[TickPlacement=Outside] /template/ TickBar#TopTickBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#BottomTickBar, ^[TickPlacement=Outside] /template/ TickBar#BottomTickBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#LeftTickBar, ^[TickPlacement=Outside] /template/ TickBar#LeftTickBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#RightTickBar, ^[TickPlacement=Outside] /template/ TickBar#RightTickBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- Kumo: no color transitions and no resize feedback on the thumb —
             a size swap on hover/press was observed to flap under fast drags
             on X11, so the pill keeps a constant 18px and constant brand. -->
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </ControlTheme>

    </ResourceDictionary>
    </Styles.Resources>
</Styles>
