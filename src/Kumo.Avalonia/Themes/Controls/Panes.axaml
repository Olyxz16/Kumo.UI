<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- SplitView: Kumo pane surface (base bg, line divider) with left/right
         placement; overlay + inline + compact modes via pseudo classes.
         Top/bottom placements are unused in Kumo surfaces. -->

    <Styles.Resources>
    <ResourceDictionary>

    <ControlTheme x:Key="{x:Type SplitView}" TargetType="SplitView">
        <Setter Property="PaneBackground" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="OpenPaneLength" Value="200" />

        <Style Selector="^:left">
            <Setter Property="Template">
                <ControlTemplate>
                        <Grid Name="Container" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.PaneColumnGridLength}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Panel Name="PART_PaneRoot"
                                   Background="{TemplateBinding PaneBackground}"
                                   ClipToBounds="True"
                                   HorizontalAlignment="Left"
                                   ZIndex="100">
                                <ContentPresenter x:Name="PART_PanePresenter"
                                                  Content="{TemplateBinding Pane}"
                                                  ContentTemplate="{TemplateBinding PaneTemplate}" />
                                <Rectangle Name="HCPaneBorder"
                                           Fill="{DynamicResource KumoBrushLine}"
                                           Width="1"
                                           HorizontalAlignment="Right" />
                            </Panel>

                            <Panel Name="ContentRoot" Grid.Column="1">
                                <ContentPresenter x:Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <Rectangle Name="LightDismissLayer"
                                           Fill="Transparent"
                                           IsVisible="False" />
                            </Panel>
                        </Grid>
                    </ControlTemplate>
                </Setter>
            <Style Selector="^:overlay">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.ClosedPaneWidth}" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="Grid.Column" Value="0" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                </Style>
            </Style>
            <Style Selector="^:compactinline">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.ClosedPaneWidth}" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                </Style>
            </Style>
            <Style Selector="^:compactoverlay">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.ClosedPaneWidth}" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                </Style>
            </Style>
            <Style Selector="^:inline">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.ClosedPaneWidth}" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^:right">
            <Setter Property="Template">
                <ControlTemplate>
                        <Grid Name="Container" Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.PaneColumnGridLength}" />
                            </Grid.ColumnDefinitions>

                            <Panel Name="PART_PaneRoot"
                                   Background="{TemplateBinding PaneBackground}"
                                   ClipToBounds="True"
                                   HorizontalAlignment="Right"
                                   ZIndex="100">
                                <ContentPresenter x:Name="PART_PanePresenter"
                                                  Content="{TemplateBinding Pane}"
                                                  ContentTemplate="{TemplateBinding PaneTemplate}" />
                                <Rectangle Name="HCPaneBorder"
                                           Fill="{DynamicResource KumoBrushLine}"
                                           Width="1"
                                           HorizontalAlignment="Left" />
                            </Panel>

                            <Panel Name="ContentRoot" Grid.Column="0">
                                <ContentPresenter x:Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                <Rectangle Name="LightDismissLayer"
                                           Fill="Transparent"
                                           IsVisible="False" />
                            </Panel>
                        </Grid>
                    </ControlTemplate>
                </Setter>
            <Style Selector="^:overlay">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.ClosedPaneWidth}" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="Grid.Column" Value="1" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                </Style>
            </Style>
            <Style Selector="^:compactinline">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.ClosedPaneWidth}" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                </Style>
            </Style>
            <Style Selector="^:compactoverlay">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Grid.ColumnSpan" Value="2" />
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.ClosedPaneWidth}" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                </Style>
            </Style>
            <Style Selector="^:inline">
                <Style Selector="^ /template/ Panel#PART_PaneRoot">
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="Grid.Column" Value="1" />
                    <Setter Property="Width" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.ClosedPaneWidth}" />
                </Style>
                <Style Selector="^ /template/ Panel#ContentRoot">
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                </Style>
            </Style>
        </Style>

        <!-- Top placement: panes stack vertically (horizontal split) -->
        <Style Selector="^:top">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Name="Container" Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.PaneRowGridLength}" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Panel Name="PART_PaneRoot"
                               Background="{TemplateBinding PaneBackground}"
                               ClipToBounds="True"
                               VerticalAlignment="Top"
                               ZIndex="100">
                            <ContentPresenter x:Name="PART_PanePresenter"
                                              Content="{TemplateBinding Pane}"
                                              ContentTemplate="{TemplateBinding PaneTemplate}" />
                            <Rectangle Name="HCPaneBorder"
                                       Fill="{DynamicResource KumoBrushLine}"
                                       Height="1"
                                       VerticalAlignment="Bottom" />
                        </Panel>
                        <Panel Name="ContentRoot" Grid.Row="1">
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <Rectangle Name="LightDismissLayer"
                                       Fill="Transparent"
                                       IsVisible="False" />
                        </Panel>
                    </Grid>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:overlay /template/ Panel#PART_PaneRoot">
                <Setter Property="Height" Value="0" />
                <Setter Property="Grid.RowSpan" Value="1" />
                <Setter Property="Grid.Row" Value="0" />
            </Style>
            <Style Selector="^:compactinline /template/ Panel#PART_PaneRoot, ^:compactoverlay /template/ Panel#PART_PaneRoot, ^:inline /template/ Panel#PART_PaneRoot">
                <Setter Property="Grid.RowSpan" Value="1" />
                <Setter Property="Grid.Row" Value="0" />
                <Setter Property="Height" Value="0" />
            </Style>
            <Style Selector="^:overlay /template/ Panel#ContentRoot, ^:compactoverlay /template/ Panel#ContentRoot">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.RowSpan" Value="2" />
            </Style>
            <Style Selector="^:compactinline /template/ Panel#ContentRoot, ^:inline /template/ Panel#ContentRoot">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.RowSpan" Value="1" />
            </Style>
        </Style>

        <!-- Open inline pane: TemplateSettings keeps PaneColumnGridLength at
             Auto for Inline mode, so the open width is set here (the Avalonia reference does
             the same via :open styles). These must come after the placement
             templates so the open size wins over the closed inline size. -->
        <Style Selector="^:left:open /template/ Panel#PART_PaneRoot">
            <Setter Property="Width" Value="{TemplateBinding OpenPaneLength}" />
        </Style>
        <Style Selector="^:right:open /template/ Panel#PART_PaneRoot">
            <Setter Property="Width" Value="{TemplateBinding OpenPaneLength}" />
        </Style>
        <Style Selector="^:top:open /template/ Panel#PART_PaneRoot">
            <Setter Property="Height" Value="{TemplateBinding OpenPaneLength}" />
        </Style>
        <Style Selector="^:bottom:open /template/ Panel#PART_PaneRoot">
            <Setter Property="Height" Value="{TemplateBinding OpenPaneLength}" />
        </Style>
    </ControlTheme>

    <!-- GridSplitter: hairline rail, brand-grow grab zones on hover. -->
    <ControlTheme x:Key="{x:Type GridSplitter}" TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWestEast" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <Border Name="PART_Grip"
                            Width="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource KumoBrushLine}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Grip, ^:dragging /template/ Border#PART_Grip">
            <Setter Property="Width" Value="4" />
            <Setter Property="Background" Value="{DynamicResource KumoBrushBrand}" />
            <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusFull}" />
        </Style>
    </ControlTheme>

    </ResourceDictionary>
    </Styles.Resources>
</Styles>
