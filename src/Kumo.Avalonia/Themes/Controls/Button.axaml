<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Button: Kumo control theme (primary / danger / ghost / icon / breadcrumb / page / outline) -->

    <Styles.Resources>
    <ResourceDictionary>

    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border x:Name="PART_Fill"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BoxShadow="{DynamicResource KumoBoxShadowXs}" />
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True" />
                    <!-- Upstream emphasis buttons carry an `inset 0 1px 0 0`
                         top highlight (emphasis-bg); reproduced as a 1px
                         top-edge overlay. -->
                    <Border Name="PART_TopSheen"
                            IsHitTestVisible="False"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderThickness="0,1,0,0"
                            BorderBrush="Transparent" />
                    <!-- .loading state: centered spinner arc -->
                    <Panel Name="PART_Loading"
                           IsHitTestVisible="False"
                           IsVisible="False"
                           Width="16" Height="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderTransform="rotate(0)">
                        <Path Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="2.4" StrokeLineCap="Round" Opacity="0.25"
                              Data="M 8,1 A 7,7 0 1 1 7.99,1 Z" />
                        <Path Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="2.4" StrokeLineCap="Round"
                              Data="M 8,1 A 7,7 0 1 1 1,8" />
                    </Panel>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#PART_Fill">
            <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Fill">
            <Setter Property="Background" Value="{DynamicResource KumoBrushFill}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{DynamicResource KumoBrushButtonDisabledBg}" />
            <Setter Property="Foreground" Value="{DynamicResource KumoBrushButtonDisabledText}" />
            <Setter Property="Cursor" Value="No" />
        </Style>
        <Style Selector="^:disabled /template/ Border#PART_Fill">
            <Setter Property="Background" Value="{DynamicResource KumoBrushButtonDisabledBg}" />
        </Style>
        <Style Selector="^.primary:disabled, ^.danger:disabled">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Background" Value="{DynamicResource KumoBrushButtonPrimaryGradient}" />
            <Setter Property="Foreground" Value="{DynamicResource KumoBrushWhite}" />
        </Style>

        <!-- primary emphasis (gradient + sheen) -->
        <Style Selector="^.primary /template/ Border#PART_Fill">
            <Setter Property="Background" Value="{DynamicResource KumoBrushButtonPrimaryGradient}" />
        </Style>
        <Style Selector="^.primary /template/ Border#PART_TopSheen">
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushButtonPrimarySheen}" />
        </Style>
        <Style Selector="^.primary">
            <Setter Property="Background" Value="{DynamicResource KumoBrushButtonPrimaryGradient}" />
            <Setter Property="Foreground" Value="{DynamicResource KumoBrushWhite}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushButtonPrimaryRing}" />
        </Style>
        <Style Selector="^.primary:pointerover /template/ Border#PART_Fill">
            <Setter Property="Background" Value="{DynamicResource KumoBrushButtonPrimaryGradientHover}" />
        </Style>
        <Style Selector="^.primary:pressed /template/ Border#PART_TopSheen">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="^.primary:pressed /template/ Border#PART_Fill">
            <Setter Property="Background" Value="{DynamicResource KumoBrushBrandHover}" />
        </Style>

        <!-- danger emphasis -->
        <Style Selector="^.danger /template/ Border#PART_TopSheen">
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushButtonDangerSheen}" />
        </Style>
        <Style Selector="^.danger">
            <Setter Property="Background" Value="{DynamicResource KumoBrushButtonDangerGradient}" />
            <Setter Property="Foreground" Value="{DynamicResource KumoBrushWhite}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushButtonDangerRing}" />
        </Style>
        <Style Selector="^.danger /template/ Border#PART_Fill">
            <Setter Property="Background" Value="{DynamicResource KumoBrushButtonDangerGradient}" />
        </Style>
        <Style Selector="^.danger:pointerover /template/ Border#PART_Fill">
            <Setter Property="Background" Value="{DynamicResource KumoBrushButtonDangerGradientHover}" />
        </Style>
        <Style Selector="^.danger:pressed">
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="^.danger:pressed /template/ Border#PART_TopSheen">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="^.danger:pressed /template/ Border#PART_Fill">
            <Setter Property="Background" Value="{DynamicResource KumoBrushDanger}" />
        </Style>

        <!-- loading state: hide the label, spin the arc -->
        <Style Selector="^.loading">
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="^.loading /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^.loading /template/ Panel#PART_Loading">
            <Setter Property="IsVisible" Value="True" />
            <Style.Animations>
                <Animation Duration="0:0:1.5" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ghost -->
        <Style Selector="^.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="^.ghost /template/ Border#PART_Fill">
            <Setter Property="BoxShadow" Value="{DynamicResource KumoBoxShadowNone}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^.ghost:pointerover /template/ Border#PART_Fill">
            <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- outline: transparent bg, 1px line ring that strengthens on hover -->
        <Style Selector="^.outline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        </Style>
        <Style Selector="^.outline /template/ Border#PART_Fill">
            <Setter Property="BoxShadow" Value="{DynamicResource KumoBoxShadowNone}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^.outline:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushOutlineRingHover}" />
            <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextStrong}" />
        </Style>

        <!-- secondary destructive: neutral surface + danger text -->
        <Style Selector="^.secondary-destructive">
            <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
            <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDanger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        </Style>
        <Style Selector="^.secondary-destructive /template/ Border#PART_Fill">
            <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        </Style>
        <Style Selector="^.secondary-destructive /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDanger}" />
        </Style>
        <Style Selector="^.secondary-destructive:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushDangerRingHover}" />
        </Style>

        <!-- sm size -->
        <Style Selector="^.sm">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="{StaticResource KumoFontSizeXs}" />
            <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
        </Style>
        <Style Selector="^.sm /template/ Border#PART_Fill">
            <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
        </Style>

        <!-- icon buttons -->
        <Style Selector="^.icon">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="^.icon-sm">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="26" />
        </Style>
        <Style Selector="^.icon-circle">
            <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusFull}" />
        </Style>
        <Style Selector="^.icon-circle /template/ Border#PART_Fill">
            <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusFull}" />
        </Style>

        <!-- breadcrumb -->
        <Style Selector="^.breadcrumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
            <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextSubtle}" />
        </Style>
        <Style Selector="^.breadcrumb /template/ Border#PART_Fill">
            <Setter Property="BoxShadow" Value="{DynamicResource KumoBoxShadowNone}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
        </Style>
        <Style Selector="^.breadcrumb:pointerover /template/ Border#PART_Fill">
            <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
        </Style>
        <Style Selector="^.breadcrumb:disabled">
            <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInactive}" />
        </Style>

        <!-- pagination page -->
        <Style Selector="^.page">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushHairline}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="{StaticResource KumoFontSizeXs}" />
        </Style>
        <Style Selector="^.page /template/ Border#PART_Fill">
            <Setter Property="BoxShadow" Value="{DynamicResource KumoBoxShadowNone}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="^.page:pointerover /template/ Border#PART_Fill">
            <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
        </Style>
        <Style Selector="^.page-selected">
            <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
            <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        </Style>
        <Style Selector="^.page-selected /template/ Border#PART_Fill">
            <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        </Style>

        <!-- focus ring -->
        <Style Selector="^:focus-visible /template/ Border#PART_Fill">
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushBrand}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </ControlTheme>

    <!-- DropDownButton: Button look + trailing chevron -->
    <ControlTheme x:Key="{x:Type DropDownButton}" TargetType="DropDownButton"
                  BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border x:Name="PART_Fill"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BoxShadow="{DynamicResource KumoBoxShadowXs}" />
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      RecognizesAccessKey="True" />
                    <Path Grid.Column="1" Width="12" Height="12"
                          VerticalAlignment="Center" Margin="0,0,-4,0"
                          HorizontalAlignment="Right"
                          Data="M2 4 L6 8 L10 4"
                          Stroke="{DynamicResource KumoBrushTextSubtle}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ButtonSpinner: content + stacked Kumo chevron repeat buttons -->
    <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{DynamicResource KumoBoxShadowXs}">
                    <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        <StackPanel Grid.Column="1" Margin="0,0,1,0" IsVisible="{TemplateBinding ShowButtonSpinner}">
                            <RepeatButton Name="PART_IncreaseButton" IsEnabled="{TemplateBinding AllowSpin}"
                                          Height="16" Width="20" BorderThickness="0"
                                          Background="Transparent"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center">
                                <Path Width="10" Height="10" Data="M2 6 L5 3 L8 6"
                                          Stroke="{DynamicResource KumoBrushTextSubtle}" StrokeThickness="1.5" />
                            </RepeatButton>
                            <Border Height="1" Background="{DynamicResource KumoBrushLine}" Margin="2,0" />
                            <RepeatButton Name="PART_DecreaseButton" IsEnabled="{TemplateBinding AllowSpin}"
                                          Height="16" Width="20" BorderThickness="0"
                                          Background="Transparent"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center">
                                <Path Width="10" Height="10" Data="M2 3 L5 6 L8 3"
                                          Stroke="{DynamicResource KumoBrushTextSubtle}" StrokeThickness="1.5" />
                            </RepeatButton>
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ RepeatButton">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="^ /template/ RepeatButton:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </ControlTheme>

    </ResourceDictionary>
    </Styles.Resources>
</Styles>
