<ResourceDictionary xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Kumo.Avalonia/Themes/Palette.axaml" />
        <ResourceInclude Source="avares://Kumo.Avalonia/Themes/Tokens.axaml" />
    </ResourceDictionary.MergedDictionaries>

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="KumoBrushFocusRing" Color="{DynamicResource KumoColorFocus}" Opacity="0.5" />
            <SolidColorBrush x:Key="KumoBrushDangerRing" Color="{DynamicResource KumoColorDanger}" Opacity="0.5" />
            <SolidColorBrush x:Key="KumoBrushSwitchTrackOff" Color="{DynamicResource KumoColorNeutral200}" />
            <SolidColorBrush x:Key="KumoBrushSwitchTrackOffRing" Color="{DynamicResource KumoColorNeutral300}" />
            <SolidColorBrush x:Key="KumoBrushSwitchTrackOn" Color="{DynamicResource KumoColorBlue500}" />
            <SolidColorBrush x:Key="KumoBrushSwitchTrackOnRing" Color="{DynamicResource KumoColorBlue600}" />
            <SolidColorBrush x:Key="KumoBrushSwitchThumbOn" Color="{DynamicResource KumoColorBase}" />
            <SolidColorBrush x:Key="KumoBrushSwitchThumbOff" Color="{DynamicResource KumoColorBase}" />
            <SolidColorBrush x:Key="KumoBrushSkeletonFill" Color="#F3F4F6" />
            <SolidColorBrush x:Key="KumoBrushToastBackdrop" Color="{DynamicResource KumoColorBase}" Opacity="0.9" />
            <BoxShadows x:Key="KumoBoxShadowXs">0 1 2 0 #0D000000</BoxShadows>
            <BoxShadows x:Key="KumoBoxShadowNone">0 0 0 0 #00000000</BoxShadows>
            <SolidColorBrush x:Key="KumoBrushButtonDisabledBg" Color="{DynamicResource KumoColorBase}" Opacity="0.5" />
            <SolidColorBrush x:Key="KumoBrushOutlineRingHover" Color="{DynamicResource KumoColorNeutral950}" Opacity="0.25" />
            <SolidColorBrush x:Key="KumoBrushDangerRingHover" Color="{DynamicResource KumoColorDanger}" Opacity="0.30" />
            <SolidColorBrush x:Key="KumoBrushButtonDisabledText" Color="{DynamicResource KumoColorTextDefault}" Opacity="0.7" />
            <SolidColorBrush x:Key="KumoBrushBannerSecondaryBg" Color="{DynamicResource KumoColorContrast}" Opacity="0.05" />
            <SolidColorBrush x:Key="KumoBrushBannerSecondaryText" Color="{DynamicResource KumoColorTextDefault}" Opacity="0.7" />
            <BoxShadows x:Key="KumoBoxShadowDialog">0 20 25 -5 #08000000, 0 8 10 -6 #08000000</BoxShadows>
            <SolidColorBrush x:Key="KumoBrushDialogScrim" Color="{DynamicResource KumoColorContrast}" Opacity="0.05" />
            <BoxShadows x:Key="KumoBoxShadowSwitchThumb">0 0 1 0 #66000000, 0 1 2 0 #1A000000</BoxShadows>
            <!-- Button emphasis gradients/rings are generated in Palette.axaml -->
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="KumoBrushFocusRing" Color="{DynamicResource KumoColorFocus}" Opacity="0.5" />
            <SolidColorBrush x:Key="KumoBrushDangerRing" Color="{DynamicResource KumoColorDanger}" Opacity="0.5" />
            <SolidColorBrush x:Key="KumoBrushSwitchTrackOff" Color="{DynamicResource KumoColorNeutral700}" />
            <SolidColorBrush x:Key="KumoBrushSwitchTrackOffRing" Color="{DynamicResource KumoColorNeutral600}" />
            <SolidColorBrush x:Key="KumoBrushSwitchTrackOn" Color="{DynamicResource KumoColorBlue600}" />
            <SolidColorBrush x:Key="KumoBrushSwitchTrackOnRing" Color="{DynamicResource KumoColorBlue500}" />
            <SolidColorBrush x:Key="KumoBrushSwitchThumbOn" Color="{DynamicResource KumoColorBlue300}" />
            <SolidColorBrush x:Key="KumoBrushSwitchThumbOff" Color="{DynamicResource KumoColorNeutral800}" />
            <SolidColorBrush x:Key="KumoBrushSkeletonFill" Color="#0FFFFFFF" />
            <BoxShadows x:Key="KumoBoxShadowXs">0 1 2 0 #0D000000</BoxShadows>
            <BoxShadows x:Key="KumoBoxShadowNone">0 0 0 0 #00000000</BoxShadows>
            <SolidColorBrush x:Key="KumoBrushButtonDisabledBg" Color="{DynamicResource KumoColorBase}" Opacity="0.5" />
            <SolidColorBrush x:Key="KumoBrushOutlineRingHover" Color="{DynamicResource KumoColorNeutral700}" Opacity="0.25" />
            <SolidColorBrush x:Key="KumoBrushDangerRingHover" Color="{DynamicResource KumoColorDanger}" Opacity="0.30" />
            <SolidColorBrush x:Key="KumoBrushButtonDisabledText" Color="{DynamicResource KumoColorTextDefault}" Opacity="0.7" />
            <SolidColorBrush x:Key="KumoBrushBannerSecondaryBg" Color="{DynamicResource KumoColorContrast}" Opacity="0.05" />
            <SolidColorBrush x:Key="KumoBrushBannerSecondaryText" Color="{DynamicResource KumoColorTextDefault}" Opacity="0.7" />
            <SolidColorBrush x:Key="KumoBrushToastBackdrop" Color="{DynamicResource KumoColorBase}" Opacity="0.9" />
            <SolidColorBrush x:Key="KumoBrushDialogScrim" Color="{DynamicResource KumoColorContrast}" Opacity="0.05" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
    <FontFamily x:Key="KumoFontMono">JetBrains Mono, Cascadia Code, Consolas, Menlo, monospace</FontFamily>

    <!-- Shared structural chrome (usable via DynamicResource from any template) -->
    <CornerRadius x:Key="ControlCornerRadius">6,6,6,6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8,8,8,8</CornerRadius>
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource KumoColorBase}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource KumoColorLine}" />
    <Thickness x:Key="ComboBoxDropdownBorderThickness">1</Thickness>
    <Thickness x:Key="ComboBoxDropdownBorderPadding">0,6</Thickness>
    <SolidColorBrush x:Key="AutoCompleteBoxSuggestionsListBackground" Color="{DynamicResource KumoColorBase}" />
    <SolidColorBrush x:Key="AutoCompleteBoxSuggestionsListBorderBrush" Color="{DynamicResource KumoColorLine}" />
    <Thickness x:Key="AutoCompleteListBorderThemeThickness">1</Thickness>
    <Thickness x:Key="AutoCompleteListMargin">6</Thickness>
    <Thickness x:Key="AutoCompleteListPadding">0</Thickness>
    <x:Double x:Key="ToolTipContentMaxWidth">320</x:Double>
    <x:Double x:Key="MenuFlyoutSubItemPopupHorizontalOffset">-4</x:Double>
    <Thickness x:Key="MenuIconPresenterMargin">0,0,12,0</Thickness>
    <Thickness x:Key="MenuInputGestureTextMargin">24,0,0,0</Thickness>
    <Thickness x:Key="MenuFlyoutScrollerMargin">0,0,0,0</Thickness>
    <Thickness x:Key="MenuFlyoutPresenterThemePadding">0,6</Thickness>
    <StreamGeometry x:Key="MenuItemChevronPathData">M 1,0 10,10 l -9,10 -1,-1 L 8,10 L 0,1 Z</StreamGeometry>

</ResourceDictionary>
