<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Button -->

    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushFillHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushFill}" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInactive}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBrand}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInverse}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBrandHover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBrandHover}" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource KumoBrushDanger}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInverse}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushDanger}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushBrand}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- TextBox: bg-control, line ring, focus ring kumo-focus/50 (1.5px), placeholder token -->

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource KumoBrushBrand}" />
        <Setter Property="CaretBrush" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="Cursor" Value="IBeam" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
    </Style>
    <Style Selector="TextBox /template/ TextBlock#PART_TextElement">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextPlaceholder}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushFocusRing}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="TextBox:focus-visible /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushBrand}" />
    </Style>
    <Style Selector="TextBox:disabled">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInactive}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
    </Style>

    <!-- ToolTip: contrast surface, inverse text -->

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource KumoBrushContrast}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInverse}" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusSm}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeSm}" />
        <Setter Property="MaxWidth" Value="320" />
    </Style>

    <!-- CheckBox: 16px box, hairline ring, contrast fill when checked, 2px focus ring -->

    <Styles.Resources>
    <ResourceDictionary>

    <CornerRadius x:Key="ControlCornerRadius">6,6,6,6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8,8,8,8</CornerRadius>
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource KumoColorBase}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource KumoColorLine}" />
    <Thickness x:Key="ComboBoxDropdownBorderThickness">1</Thickness>
    <Thickness x:Key="ComboBoxDropdownBorderPadding">0,6</Thickness>

    <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                    <Panel VerticalAlignment="Top" Margin="0,2,0,0" Width="16" Height="16">
                        <Border x:Name="Box"
                                Width="16" Height="16"
                                CornerRadius="4"
                                Background="{DynamicResource KumoBrushBase}"
                                BorderBrush="{DynamicResource KumoBrushHairline}"
                                BorderThickness="1" />
                        <Path x:Name="CheckGlyph"
                              IsVisible="False"
                              Data="M 3.5,8.5 L 6.5,11.5 L 12.5,4.5"
                              Stroke="{DynamicResource KumoBrushTextInverse}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                        <Path x:Name="MinusGlyph"
                              IsVisible="False"
                              Data="M 3.5,8 L 12.5,8"
                              Stroke="{DynamicResource KumoBrushTextInverse}"
                              StrokeThickness="2"
                              StrokeLineCap="Round" />
                    </Panel>
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      RecognizesAccessKey="True"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#Box">
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushHairline}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#Box">
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushBrand}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="^:checked /template/ Border#Box">
            <Setter Property="Background" Value="{DynamicResource KumoBrushContrast}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushContrast}" />
        </Style>
        <Style Selector="^:checked /template/ Path#CheckGlyph">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:indeterminate /template/ Border#Box">
            <Setter Property="Background" Value="{DynamicResource KumoBrushContrast}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushContrast}" />
        </Style>
        <Style Selector="^:indeterminate /template/ Path#MinusGlyph">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInactive}" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style Selector="^.error /template/ Border#Box">
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushDanger}" />
        </Style>
    </ControlTheme>

    <!-- ToggleSwitch: 36x18 squircle track, 18px thumb, blue-500/600 checked -->
    <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="KnobTransitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Easing="CubicEaseOut" Property="Canvas.Left" Duration="0:0:0.1" />
                </Transitions>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Background="{TemplateBinding Background}" RowDefinitions="Auto,*">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Grid.Row="0"
                                          VerticalAlignment="Top"
                                          Margin="0,0,0,6"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <Grid Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" MaxWidth="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="SwitchAreaGrid"
                                  Grid.RowSpan="3" Grid.ColumnSpan="3"
                                  Background="Transparent"
                                  Margin="0,5"
                                  TemplatedControl.IsTemplateFocusTarget="True" />
                            <ContentPresenter x:Name="PART_OffContentPresenter"
                                              Grid.RowSpan="3" Grid.Column="2"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding OffContent}"
                                              ContentTemplate="{TemplateBinding OffContentTemplate}" />
                            <ContentPresenter x:Name="PART_OnContentPresenter"
                                              Grid.RowSpan="3" Grid.Column="2"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding OnContent}"
                                              ContentTemplate="{TemplateBinding OnContentTemplate}" />
                            <Border x:Name="OuterBorder"
                                    Grid.Row="1"
                                    Width="36" Height="18"
                                    CornerRadius="5"
                                    BorderThickness="1"
                                    Background="{DynamicResource KumoBrushSwitchTrackOff}"
                                    BorderBrush="{DynamicResource KumoBrushSwitchTrackOffRing}" />
                            <Border x:Name="SwitchKnobBounds"
                                    Grid.Row="1"
                                    Width="36" Height="18"
                                    CornerRadius="5"
                                    BorderThickness="1"
                                    Background="{DynamicResource KumoBrushSwitchTrackOn}"
                                    BorderBrush="{DynamicResource KumoBrushSwitchTrackOnRing}" />
                            <Canvas x:Name="PART_SwitchKnob"
                                    Grid.Row="1"
                                    Width="18" Height="18"
                                    HorizontalAlignment="Left">
                                <Grid x:Name="PART_MovingKnobs" Width="18" Height="18">
                                    <Ellipse x:Name="SwitchKnobOn"
                                             Fill="{DynamicResource KumoBrushSwitchThumbOn}"
                                             Width="18" Height="18" />
                                    <Ellipse x:Name="SwitchKnobOff"
                                             Fill="{DynamicResource KumoBrushSwitchThumbOff}"
                                             Width="18" Height="18" />
                                </Grid>
                            </Canvas>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter:empty">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^:checked /template/ Border#OuterBorder">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#SwitchKnobOff">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:checked /template/ Border#SwitchKnobBounds">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#SwitchKnobOn">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:checked /template/ ContentPresenter#PART_OffContentPresenter">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:checked /template/ ContentPresenter#PART_OnContentPresenter">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:unchecked /template/ Border#OuterBorder">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:unchecked /template/ Ellipse#SwitchKnobOff">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:unchecked /template/ Ellipse#SwitchKnobOn">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:unchecked /template/ Border#SwitchKnobBounds">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:unchecked /template/ ContentPresenter#PART_OffContentPresenter">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:unchecked /template/ ContentPresenter#PART_OnContentPresenter">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#OuterBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushBrand}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </ControlTheme>

    <!-- RadioButton: 16px circle, 2px line ring, contrast fill + dot when checked -->


    <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                    <Panel VerticalAlignment="Top" Margin="0,2,0,0" Width="16" Height="16">
                        <Ellipse x:Name="Circle"
                                 Width="16" Height="16"
                                 Fill="{DynamicResource KumoBrushBase}"
                                 Stroke="{DynamicResource KumoBrushLine}"
                                 StrokeThickness="2" />
                        <Ellipse x:Name="Dot"
                                 IsVisible="False"
                                 Width="6" Height="6"
                                 Fill="{DynamicResource KumoBrushTextInverse}" />
                    </Panel>
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      RecognizesAccessKey="True"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Ellipse#Circle">
            <Setter Property="Stroke" Value="{DynamicResource KumoBrushHairline}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Ellipse#Circle">
            <Setter Property="Stroke" Value="{DynamicResource KumoBrushBrand}" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#Circle">
            <Setter Property="Fill" Value="{DynamicResource KumoBrushContrast}" />
            <Setter Property="Stroke" Value="{DynamicResource KumoBrushContrast}" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#Dot">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInactive}" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style Selector="^.error /template/ Ellipse#Circle">
            <Setter Property="Stroke" Value="{DynamicResource KumoBrushDanger}" />
        </Style>
    </ControlTheme>

    </ResourceDictionary>
    </Styles.Resources>

    <!-- ComboBox: control bg, line ring, inset focus ring, base popup with shadow -->

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5,0,5" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource KumoBrushTextPlaceholder}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
    </Style>
    <Style Selector="ComboBox:pressed /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
    </Style>
    <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushFocusRing}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="ComboBox:focus-visible /template/ Border#Background">
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ComboBox:disabled">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInactive}" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="ComboBox:error /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushDanger}" />
    </Style>
    <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextSubtle}" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ComboBoxItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
    </Style>

    <!-- TabControl (segmented): recessed list, base active tab with line ring -->

    <Style Selector="TabControl">
        <Setter Property="Background" Value="{DynamicResource KumoBrushRecessed}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextSubtle}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TabItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource KumoBrushRecessed}" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
    </Style>
    <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource KumoBrushRecessed}" />
    </Style>
    <Style Selector="TabItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="{StaticResource KumoShadowSm}" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TabItem:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- ProgressBar: fill = token color (default brand), track = recessed -->

    <Style Selector="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource KumoBrushRecessed}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushBrand}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusFull}" />
        <Setter Property="MinHeight" Value="4" />
    </Style>
    <Style Selector="ProgressBar.success">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushSuccess}" />
    </Style>
    <Style Selector="ProgressBar.danger">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushDanger}" />
    </Style>

    <!-- Expander: plain trigger, left-border content (Kumo collapsible) -->

    <Style Selector="Expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushFill}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="16,4" />
        <Setter Property="Margin" Value="0,8" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ Border#ToggleButtonBackground">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Expander /template/ Border#ExpanderContent">
        <Setter Property="Margin" Value="0,4,0,8" />
    </Style>

    <!-- Flyouts, popups, menus: base surface, line ring, lg radius, shadow -->

    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeSm}" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="Padding" Value="0,6" />
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="Padding" Value="0,6" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
    </Style>
    <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
    </Style>
    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
    </Style>
    <Style Selector="MenuItem:disabled">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInactive}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource KumoBrushHairline}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="2,4" />
    </Style>

    <!-- Badge presets (Border classes): rounded-full, xs medium text -->

    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusFull}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource KumoFontSizeXs}" />
        <Setter Property="TextElement.FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Border.badge.primary">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBadgeInverted}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextBadgeInverted}" />
    </Style>
    <Style Selector="Border.badge.secondary">
        <Setter Property="Background" Value="{DynamicResource KumoBrushFill}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextBadgeNeutralSubtle}" />
    </Style>
    <Style Selector="Border.badge.info">
        <Setter Property="Background" Value="{DynamicResource KumoBrushInfoTint}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextInfo}" />
    </Style>
    <Style Selector="Border.badge.success">
        <Setter Property="Background" Value="{DynamicResource KumoBrushSuccessTint}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextSuccess}" />
    </Style>
    <Style Selector="Border.badge.warning">
        <Setter Property="Background" Value="{DynamicResource KumoBrushWarningTint}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextWarning}" />
    </Style>
    <Style Selector="Border.badge.error">
        <Setter Property="Background" Value="{DynamicResource KumoBrushDangerTint}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextDanger}" />
    </Style>
    <Style Selector="Border.badge.outline">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushFill}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
    </Style>
    <Style Selector="Border.badge.beta">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushBrand}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextLink}" />
    </Style>
    <Style Selector="Border.badge.red">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBadgeRed}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushWhite}" />
    </Style>
    <Style Selector="Border.badge.green">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBadgeGreen}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushWhite}" />
    </Style>
    <Style Selector="Border.badge.neutral">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBadgeNeutral}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushWhite}" />
    </Style>
    <Style Selector="Border.badge.orange">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBadgeOrange}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushBlack}" />
    </Style>
    <Style Selector="Border.badge.purple">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBadgePurple}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushWhite}" />
    </Style>
    <Style Selector="Border.badge.teal">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBadgeTeal}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushWhite}" />
    </Style>
    <Style Selector="Border.badge.blue">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBadgeBlue}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushWhite}" />
    </Style>

    <!-- Banner presets (Border classes): tint surface + solid status text -->

    <Style Selector="Border.banner">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource KumoFontSizeBase}" />
    </Style>
    <Style Selector="Border.banner.info">
        <Setter Property="Background" Value="{DynamicResource KumoBrushInfoTint}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextInfo}" />
    </Style>
    <Style Selector="Border.banner.warning">
        <Setter Property="Background" Value="{DynamicResource KumoBrushWarningTint}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextWarning}" />
    </Style>
    <Style Selector="Border.banner.error">
        <Setter Property="Background" Value="{DynamicResource KumoBrushDangerTint}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextDanger}" />
    </Style>
    <Style Selector="Border.banner.secondary">
        <Setter Property="Background" Value="{DynamicResource KumoBrushFill}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
    </Style>

    <!-- Toast presets (Border classes): base surface, xl radius, line ring, lg shadow -->

    <Style Selector="Border.toast">
        <Setter Property="Background" Value="{DynamicResource KumoBrushToastBackdrop}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusXl}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BoxShadow" Value="{StaticResource KumoShadowLg}" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource KumoFontSizeBase}" />
    </Style>
    <Style Selector="Border.toast.success">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushSuccess}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextSuccess}" />
    </Style>
    <Style Selector="Border.toast.error">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushDanger}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextDanger}" />
    </Style>
    <Style Selector="Border.toast.warning">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushWarning}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextWarning}" />
    </Style>
    <Style Selector="Border.toast.info">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushInfo}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextInfo}" />
    </Style>

    <!-- Skeleton line (Border class): 8px tall shimmering bar -->

    <Style Selector="Border.skeleton-line">
        <Setter Property="Background" Value="{DynamicResource KumoBrushSkeletonFill}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Height" Value="8" />
    </Style>

    <!-- Layer card: elevated surface with hairline ring + card shadow -->

    <Style Selector="Border.layer-card">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushHairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="BoxShadow" Value="{StaticResource KumoShadowCard}" />
        <Setter Property="Padding" Value="20,16" />
    </Style>

</Styles>
