<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:k="using:KumoThemeSupport">

    <!-- Button -->

    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushFillHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushFill}" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInactive}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBrand}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInverse}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBrandHover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBrandHover}" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource KumoBrushDanger}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInverse}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushDanger}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushBrand}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- TextBox: bg-control, line ring, focus ring kumo-focus/50 (1.5px), placeholder token -->

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource KumoBrushBrand}" />
        <Setter Property="CaretBrush" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="Cursor" Value="IBeam" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
    </Style>
    <Style Selector="TextBox /template/ TextBlock#PART_TextElement">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextPlaceholder}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushFocusRing}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="TextBox:focus-visible /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushBrand}" />
    </Style>
    <Style Selector="TextBox:disabled">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInactive}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
    </Style>

    <!-- ToolTip: contrast surface, inverse text -->

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource KumoBrushContrast}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInverse}" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusSm}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeSm}" />
        <Setter Property="MaxWidth" Value="320" />
    </Style>

    <!-- CheckBox: 16px box, hairline ring, contrast fill when checked, 2px focus ring -->

    <Styles.Resources>
    <ResourceDictionary>

    <CornerRadius x:Key="ControlCornerRadius">6,6,6,6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8,8,8,8</CornerRadius>
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource KumoColorBase}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource KumoColorLine}" />
    <Thickness x:Key="ComboBoxDropdownBorderThickness">1</Thickness>
    <Thickness x:Key="ComboBoxDropdownBorderPadding">0,6</Thickness>

    <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                    <Panel VerticalAlignment="Top" Margin="0,2,0,0" Width="16" Height="16">
                        <Border x:Name="Box"
                                Width="16" Height="16"
                                CornerRadius="4"
                                Background="{DynamicResource KumoBrushBase}"
                                BorderBrush="{DynamicResource KumoBrushHairline}"
                                BorderThickness="1" />
                        <Path x:Name="CheckGlyph"
                              IsVisible="False"
                              Data="M 3.5,8.5 L 6.5,11.5 L 12.5,4.5"
                              Stroke="{DynamicResource KumoBrushTextInverse}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                        <Path x:Name="MinusGlyph"
                              IsVisible="False"
                              Data="M 3.5,8 L 12.5,8"
                              Stroke="{DynamicResource KumoBrushTextInverse}"
                              StrokeThickness="2"
                              StrokeLineCap="Round" />
                    </Panel>
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      RecognizesAccessKey="True"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#Box">
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushHairline}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#Box">
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushBrand}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="^:checked /template/ Border#Box">
            <Setter Property="Background" Value="{DynamicResource KumoBrushContrast}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushContrast}" />
        </Style>
        <Style Selector="^:checked /template/ Path#CheckGlyph">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:indeterminate /template/ Border#Box">
            <Setter Property="Background" Value="{DynamicResource KumoBrushContrast}" />
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushContrast}" />
        </Style>
        <Style Selector="^:indeterminate /template/ Path#MinusGlyph">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInactive}" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style Selector="^.error /template/ Border#Box">
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushDanger}" />
        </Style>
    </ControlTheme>

    <!-- ToggleSwitch: 36x18 squircle track, 18px thumb, blue-500/600 checked -->
    <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="KnobTransitions">
            <Setter.Value>
                <Transitions>
                    <DoubleTransition Easing="CubicEaseOut" Property="Canvas.Left" Duration="0:0:0.1" />
                </Transitions>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Background="{TemplateBinding Background}" RowDefinitions="Auto,*">
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Grid.Row="0"
                                          VerticalAlignment="Top"
                                          Margin="0,0,0,6"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <Grid Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" MaxWidth="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="SwitchAreaGrid"
                                  Grid.RowSpan="3" Grid.ColumnSpan="3"
                                  Background="Transparent"
                                  Margin="0,5"
                                  TemplatedControl.IsTemplateFocusTarget="True" />
                            <ContentPresenter x:Name="PART_OffContentPresenter"
                                              Grid.RowSpan="3" Grid.Column="2"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding OffContent}"
                                              ContentTemplate="{TemplateBinding OffContentTemplate}" />
                            <ContentPresenter x:Name="PART_OnContentPresenter"
                                              Grid.RowSpan="3" Grid.Column="2"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding OnContent}"
                                              ContentTemplate="{TemplateBinding OnContentTemplate}" />
                            <Border x:Name="OuterBorder"
                                    Grid.Row="1"
                                    Width="36" Height="18"
                                    CornerRadius="5"
                                    BorderThickness="1"
                                    Background="{DynamicResource KumoBrushSwitchTrackOff}"
                                    BorderBrush="{DynamicResource KumoBrushSwitchTrackOffRing}" />
                            <Border x:Name="SwitchKnobBounds"
                                    Grid.Row="1"
                                    Width="36" Height="18"
                                    CornerRadius="5"
                                    BorderThickness="1"
                                    Background="{DynamicResource KumoBrushSwitchTrackOn}"
                                    BorderBrush="{DynamicResource KumoBrushSwitchTrackOnRing}" />
                            <Canvas x:Name="PART_SwitchKnob"
                                    Grid.Row="1"
                                    Width="18" Height="18"
                                    HorizontalAlignment="Left">
                                <Grid x:Name="PART_MovingKnobs" Width="18" Height="18">
                                    <Ellipse x:Name="SwitchKnobOn"
                                             Fill="{DynamicResource KumoBrushSwitchThumbOn}"
                                             Width="18" Height="18" />
                                    <Ellipse x:Name="SwitchKnobOff"
                                             Fill="{DynamicResource KumoBrushSwitchThumbOff}"
                                             Width="18" Height="18" />
                                </Grid>
                            </Canvas>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter:empty">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^:checked /template/ Border#OuterBorder">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#SwitchKnobOff">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:checked /template/ Border#SwitchKnobBounds">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#SwitchKnobOn">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:checked /template/ ContentPresenter#PART_OffContentPresenter">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:checked /template/ ContentPresenter#PART_OnContentPresenter">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:unchecked /template/ Border#OuterBorder">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:unchecked /template/ Ellipse#SwitchKnobOff">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:unchecked /template/ Ellipse#SwitchKnobOn">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:unchecked /template/ Border#SwitchKnobBounds">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:unchecked /template/ ContentPresenter#PART_OffContentPresenter">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:unchecked /template/ ContentPresenter#PART_OnContentPresenter">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#OuterBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushBrand}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </ControlTheme>

    <!-- RadioButton: 16px circle, 2px line ring, contrast fill + dot when checked -->


    <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                    <Panel VerticalAlignment="Top" Margin="0,2,0,0" Width="16" Height="16">
                        <Ellipse x:Name="Circle"
                                 Width="16" Height="16"
                                 Fill="{DynamicResource KumoBrushBase}"
                                 Stroke="{DynamicResource KumoBrushLine}"
                                 StrokeThickness="2" />
                        <Ellipse x:Name="Dot"
                                 IsVisible="False"
                                 Width="6" Height="6"
                                 Fill="{DynamicResource KumoBrushTextInverse}" />
                    </Panel>
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      RecognizesAccessKey="True"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Ellipse#Circle">
            <Setter Property="Stroke" Value="{DynamicResource KumoBrushHairline}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Ellipse#Circle">
            <Setter Property="Stroke" Value="{DynamicResource KumoBrushBrand}" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#Circle">
            <Setter Property="Fill" Value="{DynamicResource KumoBrushContrast}" />
            <Setter Property="Stroke" Value="{DynamicResource KumoBrushContrast}" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#Dot">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInactive}" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style Selector="^.error /template/ Ellipse#Circle">
            <Setter Property="Stroke" Value="{DynamicResource KumoBrushDanger}" />
        </Style>
    </ControlTheme>

    <!-- NotificationCard (live toast): base surface, xl radius, status ring, enter/exit animation -->

    <ControlTheme x:Key="{x:Type NotificationCard}" TargetType="NotificationCard">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Width" Value="384" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="RenderTransformOrigin" Value="50%,75%" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="Background" Value="{DynamicResource KumoBrushToastBackdrop}" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusXl}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <LayoutTransformControl Name="PART_LayoutTransformControl" UseRenderTransform="True">
                        <Border Margin="4,0,4,12">
                            <Border x:Name="PART_Ring"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    BoxShadow="{StaticResource KumoShadowLg}">
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Margin="16"
                                                  Content="{TemplateBinding Content}" />
                            </Border>
                        </Border>
                    </LayoutTransformControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <ControlTheme.Animations>
            <Animation Duration="0:0:0.35" Easing="CubicEaseOut" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="16" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </ControlTheme.Animations>

        <Style Selector="^[IsClosing=true]">
            <Style.Animations>
                <Animation Duration="0:0:1.25" Easing="QuadraticEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="IsClosed" Value="True" />
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^:information">
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushInfo}" />
        </Style>
        <Style Selector="^:success">
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushSuccess}" />
        </Style>
        <Style Selector="^:warning">
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushWarning}" />
        </Style>
        <Style Selector="^:error">
            <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushDanger}" />
        </Style>
    </ControlTheme>

    <SolidColorBrush x:Key="AutoCompleteBoxSuggestionsListBackground" Color="{DynamicResource KumoColorBase}" />
    <SolidColorBrush x:Key="AutoCompleteBoxSuggestionsListBorderBrush" Color="{DynamicResource KumoColorLine}" />
    <Thickness x:Key="AutoCompleteListBorderThemeThickness">1</Thickness>
    <Thickness x:Key="AutoCompleteListMargin">6</Thickness>
    <Thickness x:Key="AutoCompleteListPadding">0</Thickness>
    </ResourceDictionary>
    </Styles.Resources>

    <!-- ComboBox: control bg, line ring, inset focus ring, base popup with shadow -->

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5,0,5" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource KumoBrushTextPlaceholder}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
    </Style>
    <Style Selector="ComboBox:pressed /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
    </Style>
    <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushFocusRing}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style Selector="ComboBox:focus-visible /template/ Border#Background">
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ComboBox:disabled">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInactive}" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="ComboBox:error /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushDanger}" />
    </Style>
    <Style Selector="ComboBox /template/ PathIcon#DropDownGlyph">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextSubtle}" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ComboBoxItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
    </Style>

    <!-- TabControl (segmented): recessed list, base active tab with line ring -->

    <Style Selector="TabControl">
        <Setter Property="Background" Value="{DynamicResource KumoBrushRecessed}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextSubtle}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="TabItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource KumoBrushRecessed}" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
    </Style>
    <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource KumoBrushRecessed}" />
    </Style>
    <Style Selector="TabItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="{StaticResource KumoShadowSm}" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TabItem:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- ProgressBar: fill = token color (default brand), track = recessed -->

    <Style Selector="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource KumoBrushRecessed}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushBrand}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusFull}" />
        <Setter Property="MinHeight" Value="4" />
    </Style>
    <Style Selector="ProgressBar.success">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushSuccess}" />
    </Style>
    <Style Selector="ProgressBar.danger">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushDanger}" />
    </Style>

    <!-- Expander: plain trigger, left-border content (Kumo collapsible) -->

    <Style Selector="Expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushFill}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="16,4" />
        <Setter Property="Margin" Value="0,8" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ Border#ToggleButtonBackground">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Expander /template/ Border#ExpanderContent">
        <Setter Property="Margin" Value="0,4,0,8" />
    </Style>
    <Style Selector="Expander:expanded /template/ Border#ExpanderContent">
        <Style.Animations>
            <Animation Duration="0:0:0.15" Easing="CubicEaseOut" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="-4" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Flyouts, popups, menus: base surface, line ring, lg radius, shadow -->

    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeSm}" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="Padding" Value="0,6" />
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="Padding" Value="0,6" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
    </Style>
    <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
    </Style>
    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
    </Style>
    <Style Selector="MenuItem:disabled">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInactive}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource KumoBrushHairline}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="2,4" />
    </Style>

    <!-- Badge presets (Border classes): rounded-full, xs medium text -->

    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusFull}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource KumoFontSizeXs}" />
        <Setter Property="TextElement.FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Border.badge.primary">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBadgeInverted}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextBadgeInverted}" />
    </Style>
    <Style Selector="Border.badge.secondary">
        <Setter Property="Background" Value="{DynamicResource KumoBrushFill}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextBadgeNeutralSubtle}" />
    </Style>
    <Style Selector="Border.badge.info">
        <Setter Property="Background" Value="{DynamicResource KumoBrushInfoTint}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextInfo}" />
    </Style>
    <Style Selector="Border.badge.success">
        <Setter Property="Background" Value="{DynamicResource KumoBrushSuccessTint}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextSuccess}" />
    </Style>
    <Style Selector="Border.badge.warning">
        <Setter Property="Background" Value="{DynamicResource KumoBrushWarningTint}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextWarning}" />
    </Style>
    <Style Selector="Border.badge.error">
        <Setter Property="Background" Value="{DynamicResource KumoBrushDangerTint}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextDanger}" />
    </Style>
    <Style Selector="Border.badge.outline">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushFill}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
    </Style>
    <Style Selector="Border.badge.beta">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushBrand}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextLink}" />
    </Style>
    <Style Selector="Border.badge.red">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBadgeRed}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushWhite}" />
    </Style>
    <Style Selector="Border.badge.green">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBadgeGreen}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushWhite}" />
    </Style>
    <Style Selector="Border.badge.neutral">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBadgeNeutral}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushWhite}" />
    </Style>
    <Style Selector="Border.badge.orange">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBadgeOrange}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushBlack}" />
    </Style>
    <Style Selector="Border.badge.purple">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBadgePurple}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushWhite}" />
    </Style>
    <Style Selector="Border.badge.teal">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBadgeTeal}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushWhite}" />
    </Style>
    <Style Selector="Border.badge.blue">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBadgeBlue}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushWhite}" />
    </Style>

    <!-- Banner presets (Border classes): tint surface + solid status text -->

    <Style Selector="Border.banner">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource KumoFontSizeBase}" />
    </Style>
    <Style Selector="Border.banner.info">
        <Setter Property="Background" Value="{DynamicResource KumoBrushInfoTint}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextInfo}" />
    </Style>
    <Style Selector="Border.banner.warning">
        <Setter Property="Background" Value="{DynamicResource KumoBrushWarningTint}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextWarning}" />
    </Style>
    <Style Selector="Border.banner.error">
        <Setter Property="Background" Value="{DynamicResource KumoBrushDangerTint}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextDanger}" />
    </Style>
    <Style Selector="Border.banner.secondary">
        <Setter Property="Background" Value="{DynamicResource KumoBrushFill}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
    </Style>

    <!-- Toast presets (Border classes): base surface, xl radius, line ring, lg shadow -->

    <Style Selector="Border.toast">
        <Setter Property="Background" Value="{DynamicResource KumoBrushToastBackdrop}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusXl}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BoxShadow" Value="{StaticResource KumoShadowLg}" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource KumoFontSizeBase}" />
    </Style>
    <Style Selector="Border.toast.success">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushSuccess}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextSuccess}" />
    </Style>
    <Style Selector="Border.toast.error">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushDanger}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextDanger}" />
    </Style>
    <Style Selector="Border.toast.warning">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushWarning}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextWarning}" />
    </Style>
    <Style Selector="Border.toast.info">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushInfo}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushTextInfo}" />
    </Style>

    <!-- Skeleton line (Border class): 8px tall shimmering bar -->

    <Style Selector="Border.skeleton-line">
        <Setter Property="Background" Value="{DynamicResource KumoBrushSkeletonFill}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Height" Value="8" />
    </Style>

    <!-- Layer card: elevated surface with hairline ring + card shadow -->

    <Style Selector="Border.layer-card">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushHairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="BoxShadow" Value="{StaticResource KumoShadowCard}" />
        <Setter Property="Padding" Value="20,16" />
    </Style>


    <!-- ============================================================ -->
    <!-- Registry wave 2: loader, link, code, empty, surface, text,   -->
    <!-- field, toolbar, menubar, meter, loader sizes, input group,   -->
    <!-- breadcrumbs, pagination, table, dialog, autocomplete,        -->
    <!-- input-area, sensitive input                                  -->
    <!-- ============================================================ -->

    <!-- HyperlinkButton -> Kumo Link (text-link, underline, hover 70%) -->
    <Style Selector="HyperlinkButton">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextLink}" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="HyperlinkButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="HyperlinkButton.plain">
        <Setter Property="TextBlock.TextDecorations" Value="{x:Static k:KumoStatics.NoTextDecorations}" />
    </Style>
    <Style Selector="HyperlinkButton:pointerover">
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="TextBlock.link">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextLink}" />
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <!-- Code: inline mono + block container -->
    <Style Selector="TextBlock.code">
        <Setter Property="FontFamily" Value="{StaticResource KumoFontMono}" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeSm}" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextSubtle}" />
    </Style>
    <Style Selector="Border.code-block">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushFill}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.code-block > TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource KumoFontMono}" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeSm}" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.code-block > SelectableTextBlock">
        <Setter Property="FontFamily" Value="{StaticResource KumoFontMono}" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeSm}" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Empty state -->
    <Style Selector="Border.empty">
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushFill}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusXl}" />
        <Setter Property="Padding" Value="40,64" />
    </Style>
    <Style Selector="Border.empty-sm">
        <Setter Property="Padding" Value="24,32" />
    </Style>
    <Style Selector="Border.empty-lg">
        <Setter Property="Padding" Value="48,80" />
    </Style>
    <Style Selector="TextBlock.empty-title">
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeXxl}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.empty-description">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextSubtle}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="560" />
    </Style>
    <Style Selector="Border.empty-command">
        <Setter Property="Background" Value="{DynamicResource KumoBrushOverlay}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="Padding" Value="12,0,8,0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="BoxShadow" Value="{StaticResource KumoShadowSm}" />
    </Style>
    <Style Selector="Border.empty-command:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushInteract}" />
    </Style>
    <Style Selector="TextBlock.empty-command-prefix">
        <Setter Property="FontFamily" Value="{StaticResource KumoFontMono}" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeXs}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInactive}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.empty-command-text">
        <Setter Property="FontFamily" Value="{StaticResource KumoFontMono}" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushBrand}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Surface: flat card (no elevation) -->
    <Style Selector="Border.surface">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="BoxShadow" Value="{StaticResource KumoShadowXs}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Text presets -->
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeLg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
    </Style>
    <Style Selector="TextBlock.title-xl">
        <Setter Property="FontSize" Value="{StaticResource KumoFontSize3xl}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
    </Style>
    <Style Selector="TextBlock.title-lg">
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeXxl}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextSubtle}" />
    </Style>
    <Style Selector="TextBlock.danger">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDanger}" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="{StaticResource KumoFontMono}" />
    </Style>
    <Style Selector="TextBlock.mono-secondary">
        <Setter Property="FontFamily" Value="{StaticResource KumoFontMono}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextSubtle}" />
    </Style>

    <!-- Field presets (Label / description / error) -->
    <Style Selector="TextBlock.field-label">
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
    </Style>
    <Style Selector="TextBlock.field-description">
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeSm}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextSubtle}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.field-error">
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeSm}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDanger}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.field-optional">
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeXs}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextSubtle}" />
    </Style>

    <!-- Icon buttons (ghost square) -->
    <Style Selector="Button.icon">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon-sm">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="MinWidth" Value="26" />
    </Style>
    <Style Selector="Button.icon-circle">
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusFull}" />
    </Style>
    <Style Selector="Button.icon-circle /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusFull}" />
    </Style>

    <!-- Toolbar: grouped controls with internal dividers -->
    <Style Selector="Border.toolbar">
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="BoxShadow" Value="{StaticResource KumoShadowXs}" />
    </Style>
    <Style Selector="Border.toolbar Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.toolbar Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Border.toolbar Button:nth-child(n+2)">
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
    </Style>
    <Style Selector="Border.toolbar Button:nth-child(1) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="6,0,0,6" />
    </Style>
    <Style Selector="Border.toolbar Button:nth-last-child(1) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0,6,6,0" />
    </Style>
    <Style Selector="Border.toolbar TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Border.toolbar Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
    </Style>

    <!-- MenuBar (upstream deprecated; toolbar-style nav strip) -->
    <Style Selector="Border.menubar">
        <Setter Property="Background" Value="{DynamicResource KumoBrushRecessed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="BoxShadow" Value="{StaticResource KumoShadowXs}" />
        <Setter Property="Padding" Value="1,0" />
    </Style>
    <Style Selector="Border.menubar Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.menubar Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
    </Style>
    <Style Selector="Border.menubar Button:nth-child(1) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="6,0,0,6" />
    </Style>
    <Style Selector="Border.menubar Button:nth-last-child(1) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0,6,6,0" />
    </Style>
    <Style Selector="Border.menubar Button.active">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
    </Style>

    <!-- Meter presets: 8px track, semantic fills -->
    <Style Selector="ProgressBar.meter">
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Background" Value="{DynamicResource KumoBrushFill}" />
    </Style>
    <Style Selector="ProgressBar.meter.warning">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushWarning}" />
    </Style>
    <Style Selector="ProgressBar.meter.info">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushInfo}" />
    </Style>

    <!-- Loader: rotating arc spinner (color via TextElement.Foreground) -->
    <Style Selector="ContentControl.loader">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource KumoBrushBrand}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Path Stroke="{TemplateBinding TextElement.Foreground}"
                          StrokeThickness="2.4" StrokeLineCap="Round" Opacity="0.15"
                          Data="M 12,2 A 10,10 0 1 1 11.99,2 Z" />
                    <Panel Name="PART_Spin" RenderTransform="rotate(0)">
                        <Path Stroke="{TemplateBinding TextElement.Foreground}"
                              StrokeThickness="2.4" StrokeLineCap="Round"
                              Data="M 12,2 A 10,10 0 1 1 2,12" />
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ContentControl.loader /template/ Panel#PART_Spin">
        <Style.Animations>
            <Animation Duration="0:0:1.5" IterationCount="Infinite">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="ContentControl.loader-sm">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="ContentControl.loader-lg">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
    </Style>

    <!-- InputArea: multiline text box -->
    <Style Selector="TextBox.multiline">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <!-- SensitiveInput: masked by default (reveal via markup/code) -->
    <Style Selector="TextBox.password">
        <Setter Property="PasswordChar" Value="&#8226;" />
        <Setter Property="FontFamily" Value="{StaticResource KumoFontMono}" />
    </Style>

    <!-- InputGroup: compound field with addons -->
    <Style Selector="Border.input-group">
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style Selector="Border.input-group:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushFocusRing}" />
    </Style>
    <Style Selector="Border.input-group.invalid">
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushDanger}" />
    </Style>
    <Style Selector="Border.input-group TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="Border.input-group Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="Border.input-group Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Border.input-group TextBox:nth-child(1) /template/ Border#PART_BorderElement">
        <Setter Property="CornerRadius" Value="6,0,0,6" />
    </Style>
    <Style Selector="Border.input-group Button:nth-child(1) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="6,0,0,6" />
    </Style>
    <Style Selector="Border.input-group TextBox:nth-last-child(1) /template/ Border#PART_BorderElement">
        <Setter Property="CornerRadius" Value="0,6,6,0" />
    </Style>
    <Style Selector="Border.input-group Button:nth-last-child(1) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0,6,6,0" />
    </Style>

    <!-- Breadcrumbs -->
    <Style Selector="Button.breadcrumb">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextSubtle}" />
    </Style>
    <Style Selector="Button.breadcrumb /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.breadcrumb:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
    </Style>
    <Style Selector="Button.breadcrumb:disabled">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInactive}" />
    </Style>
    <Style Selector="TextBlock.breadcrumb-current">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
    </Style>
    <Style Selector="TextBlock.breadcrumb-separator">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextInactive}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="2,0" />
    </Style>

    <!-- Pagination -->
    <Style Selector="Button.page">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeSm}" />
    </Style>
    <Style Selector="Button.page /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.page:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
    </Style>
    <Style Selector="Button.page-selected">
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
    </Style>
    <Style Selector="TextBlock.pagination-info">
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeSm}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextSubtle}" />
    </Style>
    <Style Selector="Border.pagination-separator">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Background" Value="{DynamicResource KumoBrushHairline}" />
        <Setter Property="Margin" Value="8,0" />
    </Style>

    <!-- Table composition presets -->
    <Style Selector="Border.table">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.table-header-cell">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushFill}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.table-header-cell.compact">
        <Setter Property="Background" Value="{DynamicResource KumoBrushElevated}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.table-header-cell > TextBlock">
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
    </Style>
    <Style Selector="Border.table-header-cell.compact > TextBlock">
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeXs}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextStrong}" />
    </Style>
    <Style Selector="Border.table-cell">
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.table-cell.compact">
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.table-row">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.table-row.alt">
        <Setter Property="Background" Value="{DynamicResource KumoBrushElevated}" />
    </Style>
    <Style Selector="Border.table-row.selected">
        <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
    </Style>
    <Style Selector="Border.table-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource KumoBrushTint}" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- Dialog surface + window chrome -->
    <Style Selector="Border.dialog-surface">
        <Setter Property="Background" Value="{DynamicResource KumoBrushBase}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusXl}" />
        <Setter Property="BoxShadow" Value="{DynamicResource KumoBoxShadowDialog}" />
        <Setter Property="Padding" Value="32" />
        <Setter Property="Width" Value="384" />
    </Style>
    <Style Selector="Border.dialog-surface.sm">
        <Setter Property="Width" Value="288" />
    </Style>
    <Style Selector="Border.dialog-surface.lg">
        <Setter Property="Width" Value="512" />
    </Style>
    <Style Selector="Border.dialog-surface.xl">
        <Setter Property="Width" Value="768" />
    </Style>
    <Style Selector="TextBlock.dialog-title">
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeLg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
    </Style>
    <Style Selector="TextBlock.dialog-description">
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextSubtle}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Window.dialog">
        <Setter Property="Background" Value="{DynamicResource KumoBrushRecessed}" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="WindowStartupLocation" Value="CenterOwner" />
        <Setter Property="CanResize" Value="False" />
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
    </Style>

    <!-- AutoCompleteBox: Kumo input + dropdown list -->
    <Style Selector="AutoCompleteBox">
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource KumoBrushTextPlaceholder}" />
    </Style>
    <Style Selector="AutoCompleteBox /template/ TextBox#PART_TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="AutoCompleteBox /template/ Border#PART_SuggestionsContainer">
        <Setter Property="Background" Value="{DynamicResource KumoBrushControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource KumoBrushLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusLg}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="BoxShadow" Value="{StaticResource KumoShadowLg}" />
    </Style>
    <Style Selector="AutoCompleteBox /template/ ListBox#PART_SelectingItemsControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="FontSize" Value="{StaticResource KumoFontSizeBase}" />
        <Setter Property="Foreground" Value="{DynamicResource KumoBrushTextDefault}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource KumoRadiusMd}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushOverlay}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource KumoBrushOverlay}" />
    </Style>

</Styles>
