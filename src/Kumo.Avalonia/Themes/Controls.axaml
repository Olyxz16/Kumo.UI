<Styles xmlns="https://github.com/avaloniaui">

    <!-- Kumo control theme registry. Each Themes/Controls/* file owns the
         ControlThemes + preset styles for one component family; include them
         here in dependency order (Shared infra first). -->

    <StyleInclude Source="avares://Kumo.Avalonia/Themes/Controls/Shared.axaml" />
    <StyleInclude Source="avares://Kumo.Avalonia/Themes/Controls/Roots.axaml" />
    <StyleInclude Source="avares://Kumo.Avalonia/Themes/Controls/Typography.axaml" />
    <StyleInclude Source="avares://Kumo.Avalonia/Themes/Controls/Button.axaml" />
    <StyleInclude Source="avares://Kumo.Avalonia/Themes/Controls/TextBox.axaml" />
    <StyleInclude Source="avares://Kumo.Avalonia/Themes/Controls/CheckBox.axaml" />
    <StyleInclude Source="avares://Kumo.Avalonia/Themes/Controls/ComboBox.axaml" />
    <StyleInclude Source="avares://Kumo.Avalonia/Themes/Controls/AutoCompleteBox.axaml" />
    <StyleInclude Source="avares://Kumo.Avalonia/Themes/Controls/Tabs.axaml" />
    <StyleInclude Source="avares://Kumo.Avalonia/Themes/Controls/Progress.axaml" />
    <StyleInclude Source="avares://Kumo.Avalonia/Themes/Controls/Expander.axaml" />
    <StyleInclude Source="avares://Kumo.Avalonia/Themes/Controls/Scroll.axaml" />
    <StyleInclude Source="avares://Kumo.Avalonia/Themes/Controls/PopupChrome.axaml" />
    <StyleInclude Source="avares://Kumo.Avalonia/Themes/Controls/Toast.axaml" />
    <StyleInclude Source="avares://Kumo.Avalonia/Themes/Controls/Link.axaml" />
    <StyleInclude Source="avares://Kumo.Avalonia/Themes/Controls/Presets.axaml" />
    <StyleInclude Source="avares://Kumo.Avalonia/Themes/Controls/Kumo.axaml" />

</Styles>
