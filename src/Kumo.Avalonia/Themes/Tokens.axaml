<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:Double x:Key="KumoFontSizeXs">12</x:Double>
    <x:Double x:Key="KumoFontSizeSm">13</x:Double>
    <x:Double x:Key="KumoFontSizeBase">14</x:Double>
    <x:Double x:Key="KumoFontSizeLg">16</x:Double>
    <x:Double x:Key="KumoFontSizeXl">20</x:Double>
    <x:Double x:Key="KumoFontSizeXxl">24</x:Double>
    <x:Double x:Key="KumoFontSize3xl">30</x:Double>
    <x:Double x:Key="KumoLineHeightBase">21</x:Double>
    <x:Double x:Key="KumoLineHeightLg">24</x:Double>

    <x:Double x:Key="KumoSpace1">4</x:Double>
    <x:Double x:Key="KumoSpace2">8</x:Double>
    <x:Double x:Key="KumoSpace3">12</x:Double>
    <x:Double x:Key="KumoSpace4">16</x:Double>
    <x:Double x:Key="KumoSpace5">20</x:Double>
    <x:Double x:Key="KumoSpace6">24</x:Double>
    <x:Double x:Key="KumoSpace8">32</x:Double>

    <CornerRadius x:Key="KumoRadiusSm">4</CornerRadius>
    <CornerRadius x:Key="KumoRadiusMd">6</CornerRadius>
    <CornerRadius x:Key="KumoRadiusLg">8</CornerRadius>
    <CornerRadius x:Key="KumoRadiusXl">12</CornerRadius>
    <CornerRadius x:Key="KumoRadiusFull">9999</CornerRadius>

    <BoxShadows x:Key="KumoShadowXs">0 1 2 0 #0D000000</BoxShadows>
    <BoxShadows x:Key="KumoShadowSm">0 1 3 0 #1A000000,0 1 2 -1 #1A000000</BoxShadows>
    <BoxShadows x:Key="KumoShadowMd">0 4 6 -1 #1A000000,0 2 4 -2 #1A000000</BoxShadows>
    <BoxShadows x:Key="KumoShadowLg">0 10 15 -3 #1A000000,0 4 6 -4 #1A000000</BoxShadows>
    <BoxShadows x:Key="KumoShadowCard">0 0 1 0 #1F000000,0 1 2 0 #14000000</BoxShadows>

    <x:Double x:Key="KumoStrokeWidth">1</x:Double>
    <x:Double x:Key="KumoStrokeWidthStrong">2</x:Double>

</ResourceDictionary>
